<!--
    Theme-independent dimension and typography design tokens.
    Because these do not change across themes, they may be referenced via StaticResource.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Typography -->
    <FontFamily x:Key="Wb.FontFamily.Default">Segoe UI, Yu Gothic UI</FontFamily>
    <FontFamily x:Key="Wb.FontFamily.Monospace">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="Wb.FontSize.S">11</sys:Double>
    <sys:Double x:Key="Wb.FontSize.M">12</sys:Double>
    <sys:Double x:Key="Wb.FontSize.L">14</sys:Double>

    <!-- Spacing (based on a 4px grid) -->
    <sys:Double x:Key="Wb.Spacing.XS">2</sys:Double>
    <sys:Double x:Key="Wb.Spacing.S">4</sys:Double>
    <sys:Double x:Key="Wb.Spacing.M">8</sys:Double>
    <sys:Double x:Key="Wb.Spacing.L">12</sys:Double>

    <!-- Control metrics -->
    <sys:Double x:Key="Wb.ControlHeight">24</sys:Double>
    <sys:Double x:Key="Wb.IconSize">16</sys:Double>
    <CornerRadius x:Key="Wb.CornerRadius">2</CornerRadius>

    <!-- Common Thickness combinations -->
    <Thickness x:Key="Wb.Padding.Input">4,2</Thickness>
    <Thickness x:Key="Wb.Padding.Panel">8</Thickness>

</ResourceDictionary>
