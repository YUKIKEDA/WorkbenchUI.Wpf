<!--
    Default style for WorkbenchIcon.
    Scales 16x16 canvas Geometry via Viewbox so stroke thickness scales proportionally with display size.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wb="clr-namespace:WorkbenchUI.Wpf.Controls">

    <Style TargetType="{x:Type wb:WorkbenchIcon}">
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:WorkbenchIcon}">
                    <Viewbox Width="{TemplateBinding Size}"
                             Height="{TemplateBinding Size}"
                             Stretch="Uniform">
                        <Grid Width="16" Height="16">
                            <Path Data="{TemplateBinding Icon}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="{TemplateBinding StrokeThickness}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="{x:Null}" />
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
