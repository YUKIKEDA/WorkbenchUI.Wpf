<!--
    Default style for RangeSlider.
    Thumb and range bar positioning on the Canvas is performed in code by RangeSlider.
    Visual appearance matches standard Slider (Slider.xaml).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wb="clr-namespace:WorkbenchUI.Wpf.Controls">

    <!-- End thumbs (same shape as Wb.Slider.Thumb; duplicated because dictionaries are separate files) -->
    <Style x:Key="Wb.RangeSlider.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Root"
                            CornerRadius="6"
                            Background="{DynamicResource Wb.Brush.Accent.Default}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wb.Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wb.Brush.Accent.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Center selected-range bar (supports dragging while preserving span; hit area covers full track height) -->
    <Style x:Key="Wb.RangeSlider.RangeThumb.Horizontal" TargetType="{x:Type Thumb}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Cursor" Value="SizeAll" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar"
                                Height="4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Wb.Brush.Accent.Default}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Wb.Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Wb.Brush.Accent.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Wb.RangeSlider.RangeThumb.Vertical" TargetType="{x:Type Thumb}"
           BasedOn="{StaticResource Wb.RangeSlider.RangeThumb.Horizontal}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar"
                                Width="4"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Wb.Brush.Accent.Default}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Wb.Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Wb.Brush.Accent.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wb:RangeSlider}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:RangeSlider}">
                    <Grid MinHeight="18">
                        <!-- Background track (inset at both ends to align with Thumb centers) -->
                        <Border Height="4"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                CornerRadius="2"
                                Background="{DynamicResource Wb.Brush.Control.Hover}" />
                        <Canvas x:Name="PART_Canvas" ClipToBounds="False">
                            <Thumb x:Name="PART_RangeThumb"
                                   Style="{StaticResource Wb.RangeSlider.RangeThumb.Horizontal}" />
                            <Thumb x:Name="PART_LowerThumb"
                                   Style="{StaticResource Wb.RangeSlider.Thumb}" />
                            <Thumb x:Name="PART_UpperThumb"
                                   Style="{StaticResource Wb.RangeSlider.Thumb}" />
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type wb:RangeSlider}">
                            <Grid MinWidth="18">
                                <Border Width="4"
                                        Margin="0,6"
                                        HorizontalAlignment="Center"
                                        CornerRadius="2"
                                        Background="{DynamicResource Wb.Brush.Control.Hover}" />
                                <Canvas x:Name="PART_Canvas" ClipToBounds="False">
                                    <Thumb x:Name="PART_RangeThumb"
                                           Style="{StaticResource Wb.RangeSlider.RangeThumb.Vertical}" />
                                    <Thumb x:Name="PART_LowerThumb"
                                           Style="{StaticResource Wb.RangeSlider.Thumb}" />
                                    <Thumb x:Name="PART_UpperThumb"
                                           Style="{StaticResource Wb.RangeSlider.Thumb}" />
                                </Canvas>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
