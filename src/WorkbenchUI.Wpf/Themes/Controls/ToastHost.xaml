<!--
    Default style for ToastHost.
    Host placement (typically bottom-right of the root Grid) is configured by the application.
    Toast cards stack downward, with severity indicated by a left-edge color stripe.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wb="clr-namespace:WorkbenchUI.Wpf.Controls">

    <DataTemplate x:Key="Wb.Toast.ItemTemplate" DataType="{x:Type wb:ToastItem}">
        <Border x:Name="Card"
                Margin="0,6,0,0"
                MinWidth="260" MaxWidth="380"
                Background="{DynamicResource Wb.Brush.Surface.Elevated}"
                BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Wb.CornerRadius}"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="LevelStripe"
                           Width="3"
                           Fill="{DynamicResource Wb.Brush.Info}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Margin="10,8"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Wb.Brush.Text.Primary}" />
                <Button Grid.Column="2"
                        x:Name="PART_ToastClose"
                        Width="20" Height="20"
                        Margin="0,6,6,6"
                        VerticalAlignment="Top"
                        Focusable="False"
                        Foreground="{DynamicResource Wb.Brush.Text.Secondary}"
                        Background="Transparent"
                        ToolTip="Close">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="CloseRoot"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource Wb.CornerRadius}">
                                <Path Data="M0,0 L8,8 M8,0 L0,8"
                                      Width="8" Height="8" Stretch="None" StrokeThickness="1"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseRoot" Property="Background"
                                            Value="{DynamicResource Wb.Brush.Control.Hover}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Wb.Brush.Text.Primary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Success">
                <Setter TargetName="LevelStripe" Property="Fill" Value="{DynamicResource Wb.Brush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Warning">
                <Setter TargetName="LevelStripe" Property="Fill" Value="{DynamicResource Wb.Brush.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Error">
                <Setter TargetName="LevelStripe" Property="Fill" Value="{DynamicResource Wb.Brush.Error}" />
            </DataTrigger>
            <!-- Fade-in on display -->
            <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Card">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Card"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.15" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style TargetType="{x:Type wb:ToastHost}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:ToastHost}">
                    <ItemsControl ItemsSource="{TemplateBinding Items}"
                                  ItemTemplate="{StaticResource Wb.Toast.ItemTemplate}"
                                  Focusable="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
