<!--
    Default styles for NavigationView, NavigationViewItem, NavigationViewItemHeader, and NavigationViewItemSeparator.
    Supports expanded hierarchical tree navigation and compact icon-only rail mode with flyout popups.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wb="clr-namespace:WorkbenchUI.Wpf.Controls">

    <wb:TreeIndentConverter x:Key="Wb.NavView.IndentConverter" IndentSize="16" />
    <BooleanToVisibilityConverter x:Key="Wb.NavView.BoolToVisibility" />

    <!-- ================= NavigationViewItemSeparator ================= -->

    <Style TargetType="{x:Type wb:NavigationViewItemSeparator}">
        <Setter Property="Margin" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:NavigationViewItemSeparator}">
                    <Border Height="1"
                            Background="{DynamicResource Wb.Brush.Border.Default}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= NavigationViewItemHeader ================= -->

    <Style TargetType="{x:Type wb:NavigationViewItemHeader}">
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="{DynamicResource Wb.FontSize.S}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="14,12,12,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:NavigationViewItemHeader}">
                    <Border x:Name="HeaderRoot" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= NavigationViewItem ================= -->

    <Style TargetType="{x:Type wb:NavigationViewItem}">
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wb.FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:NavigationViewItem}">
                    <StackPanel>
                        <Border x:Name="PART_ItemButton"
                                Height="32"
                                Margin="4,1"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                Cursor="Hand"
                                ToolTip="{TemplateBinding Content}"
                                ToolTipService.IsEnabled="{TemplateBinding IsCompact}"
                                ToolTipService.InitialShowDelay="250">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Hierarchy indent spacer (expanded tree only) -->
                                <Border x:Name="IndentSpacer"
                                        Grid.Column="0"
                                        Margin="{Binding Depth, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Wb.NavView.IndentConverter}}" />

                                <!-- Fixed-width icon slot so icons align cleanly across 48px compact rail and 240px sidebar -->
                                <Border x:Name="IconSlot"
                                        Grid.Column="1"
                                        Width="38">
                                    <wb:WorkbenchIcon x:Name="ItemIcon"
                                                      Icon="{TemplateBinding Icon}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      Size="15"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>

                                <!-- Label -->
                                <ContentPresenter x:Name="ContentHost"
                                                  Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  Margin="2,0,6,0"
                                                  RecognizesAccessKey="True" />

                                <!-- Optional badge -->
                                <Border x:Name="BadgeHost"
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        Padding="6,1"
                                        CornerRadius="8"
                                        Background="{DynamicResource Wb.Brush.Control.Background}">
                                    <ContentPresenter Content="{TemplateBinding Badge}"
                                                      TextElement.FontSize="{DynamicResource Wb.FontSize.S}"
                                                      TextElement.Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
                                </Border>

                                <!-- Group expand/collapse chevron -->
                                <wb:WorkbenchIcon x:Name="ExpandChevron"
                                                  Grid.Column="4"
                                                  Icon="{x:Static wb:WorkbenchIcons.ChevronRight}"
                                                  Foreground="{DynamicResource Wb.Brush.Text.Secondary}"
                                                  Size="11"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                    <wb:WorkbenchIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </wb:WorkbenchIcon.RenderTransform>
                                </wb:WorkbenchIcon>

                                <!-- Left accent selection indicator pill (drawn on top of left column) -->
                                <Border x:Name="SelectionPill"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Width="3"
                                        Height="16"
                                        Margin="1,0,0,0"
                                        CornerRadius="1.5"
                                        Background="{DynamicResource Wb.Brush.Accent.Default}"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!-- Inline children host (active only when !IsCompact && IsExpanded) -->
                        <ItemsControl x:Name="PART_InlineChildrenHost"
                                      Focusable="False"
                                      Visibility="Collapsed" />

                        <!-- Compact mode flyout popup (active only when IsCompact && IsFlyoutOpen) -->
                        <Popup x:Name="PART_Flyout"
                               PlacementTarget="{Binding ElementName=PART_ItemButton}"
                               Placement="Right"
                               HorizontalOffset="6"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding IsFlyoutOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Border MinWidth="180"
                                    MaxHeight="480"
                                    Padding="0,4"
                                    CornerRadius="4"
                                    Background="{DynamicResource Wb.Brush.Surface.Elevated}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Strong}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      Margin="12,6,12,4"
                                                      TextElement.FontWeight="SemiBold"
                                                      TextElement.FontSize="{DynamicResource Wb.FontSize.S}"
                                                      TextElement.Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
                                    <Border Height="1"
                                            Margin="8,2,8,4"
                                            Background="{DynamicResource Wb.Brush.Border.Default}" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="PART_FlyoutChildrenHost" Focusable="False" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="ItemIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Icon" Value="{x:Null}" />
                                <Condition Property="IsCompact" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IconSlot" Property="Width" Value="10" />
                        </MultiTrigger>
                        <Trigger Property="Badge" Value="{x:Null}">
                            <Setter TargetName="BadgeHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasMenuItems" Value="False">
                            <Setter TargetName="ExpandChevron" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandChevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsCompact" Value="False" />
                                <Condition Property="IsExpanded" Value="True" />
                                <Condition Property="HasMenuItems" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_InlineChildrenHost" Property="Visibility" Value="Visible" />
                        </MultiTrigger>

                        <!-- Compact icon-rail layout -->
                        <Trigger Property="IsCompact" Value="True">
                            <Setter TargetName="IndentSpacer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BadgeHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ExpandChevron" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_InlineChildrenHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Hover & selection states -->
                        <Trigger SourceName="PART_ItemButton" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_ItemButton" Property="Background"
                                    Value="{DynamicResource Wb.Brush.State.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_ItemButton" Property="Background"
                                    Value="{DynamicResource Wb.Brush.State.Hover}" />
                            <Setter TargetName="SelectionPill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ItemIcon" Property="Foreground"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>

                        <!-- Highlight parent item when a child is selected and either compact or collapsed -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChildSelected" Value="True" />
                                <Condition Property="IsCompact" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectionPill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ItemButton" Property="Background"
                                    Value="{DynamicResource Wb.Brush.State.Hover}" />
                            <Setter TargetName="ItemIcon" Property="Foreground"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChildSelected" Value="True" />
                                <Condition Property="IsExpanded" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectionPill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ItemIcon" Property="Foreground"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                            <Setter TargetName="PART_ItemButton" Property="Cursor" Value="Arrow" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= NavigationView ================= -->

    <Style x:Key="Wb.NavigationView.ToggleButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Muted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wb.Brush.State.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wb.Brush.State.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wb:NavigationView}">
        <Setter Property="Background" Value="{DynamicResource Wb.Brush.Surface.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:NavigationView}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left navigation pane -->
                        <Border Grid.Column="0"
                                Width="{TemplateBinding PaneWidth}"
                                Background="{DynamicResource Wb.Brush.Surface.Panel}"
                                BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                BorderThickness="0,0,1,0">
                            <DockPanel>
                                <!-- Top toggle + optional PaneHeader -->
                                <Grid x:Name="PaneTopBar"
                                      DockPanel.Dock="Top"
                                      Margin="4,6,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PART_PaneToggleButton"
                                            Grid.Column="0"
                                            Style="{StaticResource Wb.NavigationView.ToggleButton}"
                                            ToolTip="{TemplateBinding PaneToggleToolTip}"
                                            Visibility="{TemplateBinding IsPaneToggleButtonVisible, Converter={StaticResource Wb.NavView.BoolToVisibility}}">
                                        <wb:WorkbenchIcon Icon="{x:Static wb:WorkbenchIcons.Menu}"
                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                          Size="15" />
                                    </Button>
                                    <ContentPresenter x:Name="PaneHeaderHost"
                                                      Grid.Column="1"
                                                      ContentSource="PaneHeader"
                                                      VerticalAlignment="Center"
                                                      Margin="4,0,6,0" />
                                </Grid>

                                <!-- Bottom PaneFooter + FooterMenuItems -->
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
                                    <Border x:Name="FooterSeparator"
                                            Height="1"
                                            Margin="10,4,10,6"
                                            Background="{DynamicResource Wb.Brush.Border.Default}"
                                            Visibility="{TemplateBinding HasFooterMenuItems, Converter={StaticResource Wb.NavView.BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{TemplateBinding EffectiveFooterMenuItems}"
                                                  Focusable="False" />
                                    <ContentPresenter x:Name="PaneFooterHost"
                                                      ContentSource="PaneFooter"
                                                      Margin="8,4,8,0" />
                                </StackPanel>

                                <!-- Primary scrollable menu items -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,0,4">
                                    <ItemsControl ItemsSource="{TemplateBinding EffectiveMenuItems}"
                                                  Focusable="False" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Main content host -->
                        <DockPanel Grid.Column="1">
                            <ContentPresenter x:Name="HeaderHost"
                                              DockPanel.Dock="Top"
                                              ContentSource="Header" />
                            <ContentPresenter ContentSource="Content" />
                        </DockPanel>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCompactPane" Value="True">
                            <Setter TargetName="PaneHeaderHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PaneFooterHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="PaneHeader" Value="{x:Null}">
                            <Setter TargetName="PaneHeaderHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="PaneFooter" Value="{x:Null}">
                            <Setter TargetName="PaneFooterHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPaneToggleButtonVisible" Value="False" />
                                <Condition Property="PaneHeader" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PaneTopBar" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
