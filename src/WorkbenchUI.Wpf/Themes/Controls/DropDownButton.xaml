<!--
    Default styles for DropDownButton / SplitButton.
    Disables hit-testing while the menu is open to avoid the classic issue where
    clicking the button while open closes the menu and immediately reopens it
    (an outside click closes the menu first and never reaches the button).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wb="clr-namespace:WorkbenchUI.Wpf.Controls">

    <Style TargetType="{x:Type wb:DropDownButton}">
        <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="MinHeight" Value="{DynamicResource Wb.ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wb.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:DropDownButton}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Wb.CornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <wb:WorkbenchIcon x:Name="ButtonIcon"
                                             Icon="{TemplateBinding wb:ButtonAssist.Icon}"
                                             Size="{TemplateBinding wb:ButtonAssist.IconSize}"
                                             Foreground="{TemplateBinding Foreground}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0" />
                                <ContentPresenter VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </StackPanel>
                            <Path Grid.Column="1"
                                  Data="M 0,0 L 3,3 L 6,0"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.2"
                                  VerticalAlignment="Center"
                                  Margin="0,1,8,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="wb:ButtonAssist.Icon" Value="{x:Null}">
                            <Setter TargetName="ButtonIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ButtonIcon" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ButtonIcon" Property="Margin" Value="0" />
                        </Trigger>
                        <!-- Prevent re-opening click while the menu is open (see file header comment) -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wb.Brush.Control.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type wb:SplitButton}">
        <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="MinHeight" Value="{DynamicResource Wb.ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wb.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:SplitButton}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Wb.CornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <wb:WorkbenchIcon x:Name="ButtonIcon"
                                             Icon="{TemplateBinding wb:ButtonAssist.Icon}"
                                             Size="{TemplateBinding wb:ButtonAssist.IconSize}"
                                             Foreground="{TemplateBinding Foreground}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0" />
                                <ContentPresenter VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Margin="0,3"
                                    Background="{DynamicResource Wb.Brush.Border.Default}" />
                            <!-- Arrow section; clicks are handled in code-behind to open the menu -->
                            <Button x:Name="PART_DropDownButton"
                                    Grid.Column="2"
                                    Focusable="False"
                                    Foreground="{TemplateBinding Foreground}"
                                    Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="0,2,2,0">
                                            <Path Data="M 0,0 L 3,3 L 6,0"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.2"
                                                  VerticalAlignment="Center"
                                                  Margin="6,1,6,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource Wb.Brush.Control.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource Wb.Brush.Control.Pressed}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="wb:ButtonAssist.Icon" Value="{x:Null}">
                            <Setter TargetName="ButtonIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ButtonIcon" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ButtonIcon" Property="Margin" Value="0" />
                        </Trigger>
                        <!-- Disable hit-testing only on the arrow section while open (main button remains clickable) -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PART_DropDownButton" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="PART_DropDownButton" Property="Background"
                                    Value="{DynamicResource Wb.Brush.Control.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Hierarchy Variants ================= -->

    <Style x:Key="Wb.DropDownButton.Accent" TargetType="{x:Type wb:DropDownButton}"
           BasedOn="{StaticResource {x:Type wb:DropDownButton}}">
        <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Accent.Default}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Text.OnAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Background}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Wb.DropDownButton.Subtle" TargetType="{x:Type wb:DropDownButton}"
           BasedOn="{StaticResource {x:Type wb:DropDownButton}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Hover}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Wb.SplitButton.Accent" TargetType="{x:Type wb:SplitButton}"
           BasedOn="{StaticResource {x:Type wb:SplitButton}}">
        <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Accent.Default}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Text.OnAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Background}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Wb.SplitButton.Subtle" TargetType="{x:Type wb:SplitButton}"
           BasedOn="{StaticResource {x:Type wb:SplitButton}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Hover}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
