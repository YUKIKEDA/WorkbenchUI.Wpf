<!--
    Default style for MatrixBox.
    Cells (NumericBox) and headers are populated into PART_Grid in code by MatrixBox.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wb="clr-namespace:WorkbenchUI.Wpf.Controls">

    <Style TargetType="{x:Type wb:MatrixBox}">
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:MatrixBox}">
                    <Grid x:Name="PART_Grid" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
