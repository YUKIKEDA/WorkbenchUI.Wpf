<!--
    Default style for CheckComboBox.
    When closed, displays summary text + chevron (matching ComboBox);
    when open, displays a list of check boxes (plus a Select All row when SelectAllContent is set).
    Structured like ComboBox: outer Border + overlaid transparent ToggleButton + Popup.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wb="clr-namespace:WorkbenchUI.Wpf.Controls">

    <!-- Full-row clickable CheckBox item -->
    <Style TargetType="{x:Type wb:CheckComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:CheckComboBoxItem}">
                    <Border x:Name="Root"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder"
                                    Width="14" Height="14"
                                    Background="{DynamicResource Wb.Brush.Surface.Input}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Strong}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 1.5,6 L 5,9.5 L 10.5,3"
                                      Stroke="{DynamicResource Wb.Brush.Text.OnAccent}"
                                      StrokeThickness="1.6"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wb.Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wb:CheckComboBox}">
        <Setter Property="Background" Value="{DynamicResource Wb.Brush.Surface.Input}" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource Wb.Padding.Input}" />
        <Setter Property="MinHeight" Value="{DynamicResource Wb.ControlHeight}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:CheckComboBox}">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Wb.CornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SummarySite"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding SummaryText}"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PlaceholderSite"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding PlaceholderText}"
                                           Foreground="{DynamicResource Wb.Brush.Text.Disabled}"
                                           Visibility="Collapsed" />
                                <Path Grid.Column="1"
                                      Data="M 0,0 L 4,4 L 8,0"
                                      Stroke="{DynamicResource Wb.Brush.Text.Secondary}"
                                      StrokeThickness="1.4"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <!-- Transparent full-area toggle for opening the drop-down -->
                        <ToggleButton x:Name="PART_ToggleButton"
                                      Focusable="True"
                                      FocusVisualStyle="{DynamicResource Wb.FocusVisual}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Rectangle Fill="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                               StaysOpen="False"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,2,8,8"
                                    Background="{DynamicResource Wb.Brush.Surface.Elevated}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Wb.CornerRadius}">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4" />
                                </Border.Effect>
                                <DockPanel Margin="0,2">
                                    <!-- 'Select All' row (shown only when SelectAllContent is specified) -->
                                    <StackPanel x:Name="SelectAllHost" DockPanel.Dock="Top">
                                        <CheckBox x:Name="PART_SelectAllCheckBox"
                                                  Margin="8,3"
                                                  IsThreeState="False"
                                                  IsChecked="{Binding SelectAllState, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Content="{TemplateBinding SelectAllContent}" />
                                        <Separator Margin="4,2" />
                                    </StackPanel>
                                    <ScrollViewer Focusable="False">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SummaryText" Value="">
                            <Setter TargetName="PlaceholderSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SelectAllContent" Value="{x:Null}">
                            <Setter TargetName="SelectAllHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="PART_ToggleButton" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource Wb.Brush.Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wb.Brush.Surface.Panel}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
