<!--
    ProcessRail / ProcessRailItem / ChapterHost / ChapterHostItem (CAE workflow rail and chapter shell)
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wb="clr-namespace:WorkbenchUI.Wpf.Controls">

    <Style TargetType="{x:Type wb:ProcessRailItem}">
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Secondary}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:ProcessRailItem}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle x:Name="Connector"
                                   Width="20" Height="1"
                                   Margin="4,0"
                                   VerticalAlignment="Center"
                                   Fill="{DynamicResource Wb.Brush.Border.Strong}" />
                        <Border x:Name="Pill"
                                Padding="10,6"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Circle"
                                        Width="22" Height="22"
                                        CornerRadius="11"
                                        Margin="0,0,8,0"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource Wb.Brush.Border.Strong}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="Number"
                                                   Text="{Binding StepNumber, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="{DynamicResource Wb.FontSize.S}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
                                        <Path x:Name="CheckMark"
                                              Data="M 1.5,5.5 L 4.5,8.5 L 9.5,2.5"
                                              Stroke="{DynamicResource Wb.Brush.Text.OnAccent}"
                                              StrokeThickness="1.6"
                                              Width="11" Height="11"
                                              Stretch="None"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFirst" Value="True">
                            <Setter TargetName="Connector" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding ShowConnectors, RelativeSource={RelativeSource AncestorType={x:Type wb:ProcessRail}}}" Value="False">
                            <Setter TargetName="Connector" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="VisualState" Value="Current">
                            <Setter TargetName="Pill" Property="Background"
                                    Value="{DynamicResource Wb.Brush.Surface.Alternate}" />
                            <Setter TargetName="Pill" Property="BorderBrush"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter TargetName="Circle" Property="BorderBrush"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter TargetName="Circle" Property="BorderThickness" Value="1.5" />
                            <Setter TargetName="Number" Property="Foreground"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="VisualState" Value="Completed">
                            <Setter TargetName="Circle" Property="Background"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter TargetName="Circle" Property="BorderBrush"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Connector" Property="Fill"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="VisualState" Value="Stale">
                            <Setter TargetName="Circle" Property="BorderBrush"
                                    Value="{DynamicResource Wb.Brush.Warning}" />
                            <Setter TargetName="Number" Property="Foreground"
                                    Value="{DynamicResource Wb.Brush.Warning}" />
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Warning}" />
                        </Trigger>
                        <Trigger Property="VisualState" Value="Locked">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background"
                                    Value="{DynamicResource Wb.Brush.Surface.Alternate}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="VisualState" Value="Locked" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Pill" Property="Background" Value="Transparent" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wb:ProcessRail}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:ProcessRail}">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wb:ChapterHostItem}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:ChapterHostItem}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wb:ChapterHost}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:ChapterHost}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
