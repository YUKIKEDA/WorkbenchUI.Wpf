<!--
    Default style for BusyOverlay.
    When IsBusy is true, blocks underlying input with a semi-transparent veil and displays
    a centered spinner + message, or BusyContent (such as ProgressDisplay).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wb="clr-namespace:WorkbenchUI.Wpf.Controls">

    <Style TargetType="{x:Type wb:BusyOverlay}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:BusyOverlay}">
                    <Grid>
                        <ContentPresenter x:Name="ContentHost" />

                        <Grid x:Name="Overlay" Visibility="Collapsed">
                            <!-- Veil (also blocks underlying input) -->
                            <Border Background="{DynamicResource Wb.Brush.Surface.Window}"
                                    Opacity="0.7" />
                            <!-- Default view: spinner + text (shown only when BusyContent is null) -->
                            <StackPanel x:Name="DefaultBusy"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <!-- Spinner uses ProgressRing; rotates only while IsBusy is true -->
                                <wb:ProgressRing x:Name="Spinner"
                                                  IsActive="{TemplateBinding IsBusy}"
                                                  HorizontalAlignment="Center" />
                                <TextBlock x:Name="BusyTextBlock"
                                           Text="{TemplateBinding BusyText}"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Wb.Brush.Text.Primary}" />
                            </StackPanel>
                            <!-- Custom content (ProgressDisplay, etc.) -->
                            <ContentPresenter x:Name="BusyContentHost"
                                              Content="{TemplateBinding BusyContent}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsBusy" Value="True">
                            <Setter TargetName="Overlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentHost" Property="IsEnabled" Value="False" />
                        </Trigger>
                        <!-- Show default spinner view when BusyContent is null -->
                        <Trigger Property="BusyContent" Value="{x:Null}">
                            <Setter TargetName="DefaultBusy" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BusyContentHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
