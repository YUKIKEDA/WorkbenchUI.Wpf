<!--
    WorkbenchRibbon / WorkbenchRibbonTab / WorkbenchRibbonGroup and ribbon button styles.
    - Wb.Ribbon.Button.Large / .Large.Accent : Large vertical button (24px icon + label)
    - Wb.Ribbon.Button.Small                 : Small horizontal button (16px icon + label)
    - Wb.Ribbon.Toggle.Large / .Small        : ToggleButton variants (accent fill when IsChecked)
    - Wb.Ribbon.SplitButton.Large.Accent     : Large vertical SplitButton (top = primary action, bottom = label + menu)
    Specify button icons with wb:ButtonAssist.Icon.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wb="clr-namespace:WorkbenchUI.Wpf.Controls">

    <!-- ================= Application Button (Left of Tab Strip) ================= -->

    <Style x:Key="Wb.Ribbon.ApplicationButton" TargetType="{x:Type wb:DropDownButton}">
        <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.OnAccent}" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wb.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:DropDownButton}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Prevent re-opening click while the menu is open (same pattern as DropDownButton.xaml) -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wb.Brush.Accent.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Pressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Ribbon ================= -->

    <Style TargetType="{x:Type wb:WorkbenchRibbon}">
        <Setter Property="Background" Value="{DynamicResource Wb.Brush.Surface.Panel}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:WorkbenchRibbon}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tab strip: application button + tabs + auxiliary area -->
                        <DockPanel LastChildFill="True">
                            <wb:DropDownButton x:Name="PART_ApplicationButton"
                                                DockPanel.Dock="Left"
                                                Margin="4,2,8,0"
                                                VerticalAlignment="Bottom"
                                                Content="{TemplateBinding ApplicationLabel}"
                                                DropDownMenu="{TemplateBinding ApplicationMenu}"
                                                AutomationProperties.AutomationId="AppMenuButton"
                                                Style="{StaticResource Wb.Ribbon.ApplicationButton}" />
                            <ContentPresenter DockPanel.Dock="Right"
                                              Content="{TemplateBinding AuxiliaryContent}"
                                              VerticalAlignment="Center"
                                              Margin="8,0" />
                            <TabPanel IsItemsHost="True"
                                      VerticalAlignment="Bottom"
                                      Margin="0,2,0,0" />
                        </DockPanel>

                        <!-- Content row (groups of the selected tab); horizontal scrolling handles narrow widths -->
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                BorderThickness="0,1,0,1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <!-- PART_SelectedContentHost: standard part name required for TabItemAutomationPeer
                                     to expose the selected tab's content to the UIA tree -->
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" MinHeight="64" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ApplicationMenu" Value="{x:Null}">
                            <Setter TargetName="PART_ApplicationButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Ribbon Tab ================= -->

    <Style TargetType="{x:Type wb:WorkbenchRibbonTab}">
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Secondary}" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wb.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:WorkbenchRibbonTab}">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1,1,1,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wb.Brush.State.Hover}" />
                        </Trigger>
                        <!-- Merge selected tab with the content row (hide bottom border) -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wb.Brush.Surface.Panel}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
                            <Setter TargetName="Root" Property="Margin" Value="0,0,0,-1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Ribbon Group ================= -->

    <Style TargetType="{x:Type wb:WorkbenchRibbonGroup}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:WorkbenchRibbonGroup}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ItemsPresenter Margin="4,3,4,1" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Row="1"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              Margin="8,0,8,2"
                                              TextElement.Foreground="{DynamicResource Wb.Brush.Text.Secondary}"
                                              TextElement.FontSize="{DynamicResource Wb.FontSize.S}" />
                        </Grid>
                        <Border Grid.Column="1"
                                Width="1"
                                Background="{DynamicResource Wb.Brush.Border.Default}"
                                Margin="2,6" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Large Ribbon Button (Vertical: 24px Icon + Label) ================= -->

    <Style x:Key="Wb.Ribbon.Button.Large" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MinWidth" Value="46" />
        <Setter Property="Padding" Value="7,5,7,3" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="FontSize" Value="{DynamicResource Wb.FontSize.S}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wb.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Wb.CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel>
                            <wb:WorkbenchIcon Icon="{TemplateBinding wb:ButtonAssist.Icon}"
                                         Size="24"
                                         Foreground="{TemplateBinding Foreground}"
                                         HorizontalAlignment="Center" />
                            <ContentPresenter Margin="0,3,0,0"
                                              HorizontalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Wb.Ribbon.Button.Large.Accent" TargetType="{x:Type Button}"
           BasedOn="{StaticResource Wb.Ribbon.Button.Large}">
        <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Accent.Default}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Text.OnAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Background}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Small Ribbon Button (Horizontal: 16px Icon + Label) ================= -->

    <Style x:Key="Wb.Ribbon.Button.Small" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="MinHeight" Value="21" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wb.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Wb.CornerRadius}">
                        <StackPanel Orientation="Horizontal"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center">
                            <wb:WorkbenchIcon x:Name="ButtonIcon"
                                         Icon="{TemplateBinding wb:ButtonAssist.Icon}"
                                         Size="16"
                                         Foreground="{TemplateBinding Foreground}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="wb:ButtonAssist.Icon" Value="{x:Null}">
                            <Setter TargetName="ButtonIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ButtonIcon" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ButtonIcon" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Ribbon Toggle (ToggleButton Variants) ================= -->

    <Style x:Key="Wb.Ribbon.Toggle.Large" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MinWidth" Value="46" />
        <Setter Property="Padding" Value="7,5,7,3" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="FontSize" Value="{DynamicResource Wb.FontSize.S}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wb.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Wb.CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel>
                            <wb:WorkbenchIcon Icon="{TemplateBinding wb:ButtonAssist.Icon}"
                                         Size="24"
                                         Foreground="{TemplateBinding Foreground}"
                                         HorizontalAlignment="Center" />
                            <ContentPresenter Margin="0,3,0,0"
                                              HorizontalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Pressed}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Muted}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Accent.Default}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Wb.Ribbon.Toggle.Small" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="MinHeight" Value="21" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wb.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Wb.CornerRadius}">
                        <StackPanel Orientation="Horizontal"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center">
                            <wb:WorkbenchIcon x:Name="ButtonIcon"
                                         Icon="{TemplateBinding wb:ButtonAssist.Icon}"
                                         Size="16"
                                         Foreground="{TemplateBinding Foreground}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="wb:ButtonAssist.Icon" Value="{x:Null}">
                            <Setter TargetName="ButtonIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ButtonIcon" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ButtonIcon" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Pressed}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Muted}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Accent.Default}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Large Ribbon SplitButton (Primary Accent) ================= -->

    <Style x:Key="Wb.Ribbon.SplitButton.Large.Accent" TargetType="{x:Type wb:SplitButton}">
        <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Accent.Default}" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="FontSize" Value="{DynamicResource Wb.FontSize.S}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wb.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:SplitButton}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Wb.CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Top = primary action (icon); clicking the SplitButton body executes Command -->
                            <wb:WorkbenchIcon Icon="{TemplateBinding wb:ButtonAssist.Icon}"
                                         Size="24"
                                         Foreground="{TemplateBinding Foreground}"
                                         Margin="10,6,10,1" />
                            <!-- Bottom = label + chevron; clicking opens the menu -->
                            <Button x:Name="PART_DropDownButton"
                                    Grid.Row="1"
                                    Focusable="False"
                                    Foreground="{TemplateBinding Foreground}"
                                    Content="{TemplateBinding Content}"
                                    Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="0,0,2,2"
                                                Padding="7,0,7,3">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <ContentPresenter RecognizesAccessKey="True"
                                                                  VerticalAlignment="Center" />
                                                <Path Data="M 0,0 L 3,3 L 6,0"
                                                      Stroke="{TemplateBinding Foreground}"
                                                      StrokeThickness="1.2"
                                                      VerticalAlignment="Center"
                                                      Margin="5,1,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource Wb.Brush.State.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource Wb.Brush.State.Pressed}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Disable hit-testing only on the arrow part while open (same pattern as DropDownButton.xaml) -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PART_DropDownButton" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="PART_DropDownButton" Property="Background"
                                    Value="{DynamicResource Wb.Brush.State.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Text.OnAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                <Setter Property="Background" Value="{DynamicResource Wb.Brush.Control.Background}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
