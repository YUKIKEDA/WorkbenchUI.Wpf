<!--
    Default styles for ColorEditor / ColorPicker.
    The SV thumb position and HueBrush / AlphaTrackBrush / PreviewBrush updates are handled
    in code-behind (ColorEditor). Because TemplatedParent bindings on Freezables inside a template
    (such as GradientStop) cannot resolve, those brushes are exposed as read-only DPs.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wb="clr-namespace:WorkbenchUI.Wpf.Controls">

    <!-- Checkerboard pattern backing transparent areas -->
    <DrawingBrush x:Key="Wb.ColorEditor.CheckerBrush"
                  TileMode="Tile"
                  Viewport="0,0,8,8"
                  ViewportUnits="Absolute"
                  Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#B0B0B0">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,4,4" />
                            <RectangleGeometry Rect="4,4,4,4" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Shared slider parts -->
    <Style x:Key="Wb.ColorEditor.PageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Wb.ColorEditor.SliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <Ellipse Stroke="#80000000" StrokeThickness="3.5" />
                        <Ellipse Stroke="White" StrokeThickness="2" Margin="0.75" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hue slider (0-360, rainbow track) -->
    <Style x:Key="Wb.ColorEditor.HueSlider" TargetType="{x:Type Slider}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid MinHeight="14">
                        <Border Height="10" VerticalAlignment="Center" CornerRadius="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0" />
                                    <GradientStop Color="#FFFF00" Offset="0.167" />
                                    <GradientStop Color="#00FF00" Offset="0.333" />
                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                    <GradientStop Color="#0000FF" Offset="0.667" />
                                    <GradientStop Color="#FF00FF" Offset="0.833" />
                                    <GradientStop Color="#FF0000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Wb.ColorEditor.PageButton}"
                                              Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Wb.ColorEditor.SliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Wb.ColorEditor.PageButton}"
                                              Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Alpha slider (checkerboard + transparent-to-current color gradient) -->
    <Style x:Key="Wb.ColorEditor.AlphaSlider" TargetType="{x:Type Slider}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid MinHeight="14">
                        <Border Height="10" VerticalAlignment="Center" CornerRadius="2"
                                Background="{StaticResource Wb.ColorEditor.CheckerBrush}" />
                        <Border Height="10" VerticalAlignment="Center" CornerRadius="2"
                                Background="{Binding AlphaTrackBrush, RelativeSource={RelativeSource AncestorType={x:Type wb:ColorEditor}}}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Wb.ColorEditor.PageButton}"
                                              Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Wb.ColorEditor.SliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Wb.ColorEditor.PageButton}"
                                              Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ColorEditor ================= -->

    <Style TargetType="{x:Type wb:ColorEditor}">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:ColorEditor}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="140" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- SV plane (Saturation = horizontal, Value = vertical) -->
                        <Grid>
                            <Border CornerRadius="2" Background="{TemplateBinding HueBrush}" />
                            <Border CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Canvas x:Name="PART_SvCanvas" Background="Transparent" ClipToBounds="False">
                                <Grid x:Name="PART_SvThumb" Width="12" Height="12" IsHitTestVisible="False">
                                    <Ellipse Stroke="#80000000" StrokeThickness="3" />
                                    <Ellipse Stroke="White" StrokeThickness="1.5" Margin="0.75" />
                                </Grid>
                            </Canvas>
                        </Grid>

                        <!-- Hue -->
                        <Slider Grid.Row="1"
                                Margin="0,8,0,0"
                                Style="{StaticResource Wb.ColorEditor.HueSlider}"
                                Minimum="0" Maximum="360"
                                Value="{Binding Hue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                        <!-- Alpha -->
                        <Slider x:Name="AlphaSlider"
                                Grid.Row="2"
                                Margin="0,6,0,0"
                                Style="{StaticResource Wb.ColorEditor.AlphaSlider}"
                                Minimum="0" Maximum="255"
                                Value="{Binding Alpha, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                        <!-- Preview + Hex -->
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="32" Margin="0,0,8,0">
                                <Border CornerRadius="2"
                                        Background="{StaticResource Wb.ColorEditor.CheckerBrush}" />
                                <Border CornerRadius="2"
                                        Background="{TemplateBinding PreviewBrush}"
                                        BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                        BorderThickness="1" />
                            </Grid>
                            <TextBox x:Name="PART_HexBox"
                                     Grid.Column="1"
                                     VerticalContentAlignment="Center"
                                     CharacterCasing="Upper" />
                        </Grid>

                        <!-- RGBA numeric inputs -->
                        <Grid Grid.Row="4" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock Text="R" DockPanel.Dock="Left" Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
                                <wb:NumericBox Minimum="0" Maximum="255" Increment="1" Format="F0"
                                                Value="{Binding Red, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            </DockPanel>
                            <DockPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="G" DockPanel.Dock="Left" Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
                                <wb:NumericBox Minimum="0" Maximum="255" Increment="1" Format="F0"
                                                Value="{Binding Green, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            </DockPanel>
                            <DockPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="B" DockPanel.Dock="Left" Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
                                <wb:NumericBox Minimum="0" Maximum="255" Increment="1" Format="F0"
                                                Value="{Binding Blue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            </DockPanel>
                            <DockPanel x:Name="AlphaField" Grid.Column="3" Margin="6,0,0,0">
                                <TextBlock Text="A" DockPanel.Dock="Left" Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
                                <wb:NumericBox Minimum="0" Maximum="255" Increment="1" Format="F0"
                                                Value="{Binding Alpha, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            </DockPanel>
                        </Grid>

                        <!-- Palette -->
                        <ItemsControl Grid.Row="5"
                                      Margin="0,8,0,0"
                                      Focusable="False"
                                      ItemsSource="{TemplateBinding Palette}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Clicks are handled by ColorEditor's class handler using element Name -->
                                    <Button x:Name="PaletteSwatch"
                                            Height="18"
                                            Margin="1"
                                            Focusable="False"
                                            ToolTip="{Binding}"
                                            AutomationProperties.Name="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Grid>
                                                    <Border x:Name="Swatch"
                                                            CornerRadius="2"
                                                            BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                                            BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding}" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Swatch" Property="BorderBrush"
                                                                Value="{DynamicResource Wb.Brush.Accent.Default}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsAlphaEnabled" Value="False">
                            <Setter TargetName="AlphaSlider" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="AlphaField" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ColorPicker (drop-down) ================= -->

    <Style TargetType="{x:Type wb:ColorPicker}">
        <Setter Property="MinHeight" Value="{DynamicResource Wb.ControlHeight}" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wb.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:ColorPicker}">
                    <Grid>
                        <ToggleButton x:Name="PART_Toggle"
                                      Focusable="False"
                                      IsTabStop="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="Root"
                                            Background="{DynamicResource Wb.Brush.Control.Background}"
                                            BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Wb.CornerRadius}">
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <Border CornerRadius="2"
                                                        Background="{StaticResource Wb.ColorEditor.CheckerBrush}" />
                                                <Border CornerRadius="2"
                                                        Background="{Binding PreviewBrush, RelativeSource={RelativeSource AncestorType={x:Type wb:ColorPicker}}}"
                                                        BorderBrush="{DynamicResource Wb.Brush.Border.Strong}"
                                                        BorderThickness="1" />
                                            </Grid>
                                            <Path Grid.Column="1"
                                                  Data="M 0,0 L 3,3 L 6,0"
                                                  Stroke="{DynamicResource Wb.Brush.Text.Secondary}"
                                                  StrokeThickness="1.2"
                                                  VerticalAlignment="Center"
                                                  Margin="6,1,2,0" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush"
                                                    Value="{DynamicResource Wb.Brush.Border.Strong}" />
                                            <Setter TargetName="Root" Property="Background"
                                                    Value="{DynamicResource Wb.Brush.Control.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush"
                                                    Value="{DynamicResource Wb.Brush.Border.Focus}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               VerticalOffset="2"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Border Background="{DynamicResource Wb.Brush.Surface.Elevated}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Wb.CornerRadius}"
                                    Padding="10">
                                <wb:ColorEditor Width="300"
                                                 SelectedColor="{Binding SelectedColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                 IsAlphaEnabled="{Binding IsAlphaEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                                                 Palette="{Binding Palette, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--
                            Disable hit-testing on the toggle while the popup is open.
                            Since an outside click closes the popup first, this avoids the common issue
                            where the same click reaches the toggle and immediately reopens the popup.
                        -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PART_Toggle" Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
