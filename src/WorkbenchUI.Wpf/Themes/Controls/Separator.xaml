<!--
    General-purpose Separator.
    Dedicated styles in Menu.xaml (MenuItem.SeparatorStyleKey), ToolBar.xaml (ToolBar.SeparatorStyleKey),
    and StatusBar.xaml (StatusBar.SeparatorStyleKey) take precedence inside those containers.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Wb.Separator" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Rectangle Height="1" Fill="{DynamicResource Wb.Brush.Border.Default}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource Wb.Separator}" />

</ResourceDictionary>
