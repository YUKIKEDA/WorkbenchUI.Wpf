<!--
    Default styles for Wizard / WizardStep / StepIndicator.
    Places StepIndicator at the top, the active step in the middle, and navigation buttons at the bottom.
    Step switching is controlled via WizardStep.Visibility so all steps remain alive to preserve state.
    Button styles are self-contained (StaticResource refs to other dictionaries are avoided).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wb="clr-namespace:WorkbenchUI.Wpf.Controls">

    <!-- Navigation button (self-contained style matching standard Button) -->
    <Style x:Key="Wb.Wizard.Button" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Wb.Brush.Surface.Input}" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
        <Setter Property="Padding" Value="14,3" />
        <Setter Property="MinHeight" Value="{DynamicResource Wb.ControlHeight}" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wb.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Wb.CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wb.Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wb.Brush.State.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Disabled}" />
                            <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent-filled primary button (for Next / Finish) -->
    <Style x:Key="Wb.Wizard.PrimaryButton" TargetType="{x:Type Button}"
           BasedOn="{StaticResource Wb.Wizard.Button}">
        <Setter Property="Background" Value="{DynamicResource Wb.Brush.Accent.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Accent.Default}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Wb.CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wb.Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wb.Brush.Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Single step item: [connector line] (numbered circle) header -->
    <Style TargetType="{x:Type wb:StepIndicatorItem}">
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Secondary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:StepIndicatorItem}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle x:Name="Connector"
                                   Width="24" Height="1"
                                   Margin="6,0"
                                   VerticalAlignment="Center"
                                   Fill="{DynamicResource Wb.Brush.Border.Strong}" />
                        <Border x:Name="Circle"
                                Width="20" Height="20"
                                CornerRadius="10"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Wb.Brush.Border.Strong}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="Number"
                                           Text="{Binding StepNumber, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{DynamicResource Wb.FontSize.S}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
                                <Path x:Name="CheckMark"
                                      Data="M 1.5,5.5 L 4.5,8.5 L 9.5,2.5"
                                      Stroke="{DynamicResource Wb.Brush.Text.OnAccent}"
                                      StrokeThickness="1.6"
                                      Width="11" Height="11"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFirst" Value="True">
                            <Setter TargetName="Connector" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="State" Value="Current">
                            <Setter TargetName="Circle" Property="BorderBrush"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter TargetName="Circle" Property="BorderThickness" Value="1.5" />
                            <Setter TargetName="Number" Property="Foreground"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="State" Value="Completed">
                            <Setter TargetName="Circle" Property="Background"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter TargetName="Circle" Property="BorderBrush"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                            <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Connector" Property="Fill"
                                    Value="{DynamicResource Wb.Brush.Accent.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wb:StepIndicator}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:StepIndicator}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WizardStep: Header is displayed in StepIndicator, so the body renders Content only -->
    <Style TargetType="{x:Type wb:WizardStep}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:WizardStep}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wb:Wizard}">
        <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Primary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wb:Wizard}">
                    <DockPanel>
                        <wb:StepIndicator DockPanel.Dock="Top"
                                           Margin="0,0,0,12"
                                           ItemsSource="{TemplateBinding StepHeaders}"
                                           CurrentIndex="{Binding CurrentIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button x:Name="PART_CancelButton"
                                    Style="{StaticResource Wb.Wizard.Button}"
                                    HorizontalAlignment="Left"
                                    Content="{TemplateBinding CancelButtonText}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="PART_BackButton"
                                        Style="{StaticResource Wb.Wizard.Button}"
                                        Content="{TemplateBinding BackButtonText}" />
                                <Button x:Name="PART_NextButton"
                                        Style="{StaticResource Wb.Wizard.PrimaryButton}"
                                        Margin="8,0,0,0"
                                        IsEnabled="{TemplateBinding CanGoNext}"
                                        Content="{TemplateBinding NextButtonText}" />
                                <Button x:Name="PART_FinishButton"
                                        Style="{StaticResource Wb.Wizard.PrimaryButton}"
                                        Margin="8,0,0,0"
                                        IsEnabled="{TemplateBinding CanFinish}"
                                        Visibility="Collapsed"
                                        Content="{TemplateBinding FinishButtonText}" />
                            </StackPanel>
                        </Grid>
                        <ItemsPresenter />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFirstStep" Value="True">
                            <Setter TargetName="PART_BackButton" Property="IsEnabled" Value="False" />
                        </Trigger>
                        <Trigger Property="IsLastStep" Value="True">
                            <Setter TargetName="PART_NextButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_FinishButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
