<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WorkbenchUI.Wpf.Viewport3D">

    <!--
        Default style for WorkbenchViewport.
        Main rendering surface is PART_Image (hosting D3DImage / WriteableBitmap);
        axis triad and rubber-band selection rectangle are on PART_TriadCanvas (not hit-test visible);
        annotation chips and leader lines are on PART_AnnotationCanvas (not hit-test visible);
        clickable ViewCube is rendered as a WPF overlay on PART_ViewCubeCanvas (hit-test visible).
        (D3DImage integrates natively into WPF composition, allowing these overlays to layer cleanly.)
    -->
    <Style TargetType="{x:Type local:WorkbenchViewport}">
        <Setter Property="Background" Value="{DynamicResource Wb.Brush.Surface.Window}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wb.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WorkbenchViewport}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid ClipToBounds="True">
                            <Image x:Name="PART_Image" Stretch="Fill" />
                            <Canvas x:Name="PART_TriadCanvas" IsHitTestVisible="False" />
                            <Canvas x:Name="PART_AnnotationCanvas" IsHitTestVisible="False" ClipToBounds="True" />
                            <Canvas x:Name="PART_ViewCubeCanvas" Background="{x:Null}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
