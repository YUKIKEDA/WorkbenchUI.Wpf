<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ShellPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Feedback &amp; Windows"
                Title="Shell &amp; ToolBars"
                Description="Composite workspace chrome demonstrating ToolBarTray overflow handling, StatusBar telemetry indicators, GridSplitter panes, and GroupBox panels."
                PackageName="WorkbenchUI.Wpf"
                NamespaceName="WorkbenchUI.Wpf.Controls" />

            <controls:ControlExample x:Name="ShellExample"
                                     HeaderText="ToolBarTray, StatusBar &amp; GridSplitter"
                                     Description="Resize the window to inspect ToolBarTray overflow behavior, or drag the center GridSplitter between workspace panes.">
                <Border BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <DockPanel>
                        <ToolBarTray DockPanel.Dock="Top">
                            <ToolBar>
                                <Button ToolTip="Open" wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.FolderOpen}" />
                                <Button ToolTip="Save" wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Save}" />
                                <Separator />
                                <Button ToolTip="Undo" wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Undo}" />
                                <ToggleButton ToolTip="Show Mesh" IsChecked="True">
                                    <wb:WorkbenchIcon Icon="{x:Static wb:WorkbenchIcons.Grid}" Size="16" />
                                </ToggleButton>
                            </ToolBar>
                            <ToolBar>
                                <Button ToolTip="Run Analysis">
                                    <StackPanel Orientation="Horizontal">
                                        <wb:WorkbenchIcon Icon="{x:Static wb:WorkbenchIcons.Play}"
                                                          Size="14"
                                                          Foreground="{DynamicResource Wb.Brush.Success}" />
                                        <TextBlock Text="Run" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </ToolBar>
                        </ToolBarTray>

                        <StatusBar DockPanel.Dock="Bottom">
                            <StatusBarItem Content="Ready" />
                            <Separator />
                            <StatusBarItem Content="Nodes: 45,230 / Elements: 38,911" />
                            <Separator />
                            <StatusBarItem Content="Units: SI (m, kg, s)" />
                            <StatusBarItem DockPanel.Dock="Right" Content="X: 12.5  Y: -3.2  Z: 0.0" />
                        </StatusBar>

                        <Grid Margin="10" Height="280">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" MinWidth="120" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="Model Parts">
                                <ListBox x:Name="PartsList" BorderThickness="0" />
                            </GroupBox>

                            <GridSplitter Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ResizeBehavior="PreviousAndNext" />

                            <GroupBox Grid.Column="2" Header="Viewport (Placeholder)">
                                <Border Background="{DynamicResource Wb.Brush.Surface.Window}" CornerRadius="2">
                                    <TextBlock Text="3D Viewport Area"
                                               Foreground="{DynamicResource Wb.Brush.Text.Disabled}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </GroupBox>
                        </Grid>
                    </DockPanel>
                </Border>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
