<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.NavigationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Wb.FontSize.L}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Text="Navigation &amp; Menus"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />

            <TextBlock Text="Menu" Style="{StaticResource SectionHeader}" />
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="_New Project" InputGestureText="Ctrl+N" />
                    <MenuItem Header="_Open..." InputGestureText="Ctrl+O" />
                    <Separator />
                    <MenuItem Header="Recent Files">
                        <MenuItem Header="bracket_static.wb" />
                        <MenuItem Header="housing_thermal.wb" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="E_xit" InputGestureText="Alt+F4" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="Model Tree" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Log Console" IsCheckable="True" />
                    <MenuItem Header="Disabled Item" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="About" />
            </Menu>

            <TextBlock Text="ContextMenu" Style="{StaticResource SectionHeader}" />
            <Border Background="{DynamicResource Wb.Brush.Surface.Panel}"
                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Wb.CornerRadius}"
                    Padding="16"
                    HorizontalAlignment="Left">
                <TextBlock Text="Right-click this area" Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Show" IsCheckable="True" IsChecked="True" />
                        <MenuItem Header="Hide" />
                        <Separator />
                        <MenuItem Header="Assign Material">
                            <MenuItem Header="Aluminum A5052" />
                            <MenuItem Header="Steel SS400" />
                        </MenuItem>
                        <MenuItem Header="Delete" InputGestureText="Del" />
                    </ContextMenu>
                </Border.ContextMenu>
            </Border>

            <TextBlock Text="TabControl" Style="{StaticResource SectionHeader}" />
            <TabControl>
                <TabItem Header="Geometry">
                    <TextBlock Text="Geometry settings content" Margin="0,8" />
                </TabItem>
                <TabItem Header="Mesh">
                    <TextBlock Text="Mesh settings content" Margin="0,8" />
                </TabItem>
                <TabItem Header="Boundary Conditions">
                    <TextBlock Text="Boundary conditions content" Margin="0,8" />
                </TabItem>
                <TabItem Header="Disabled" IsEnabled="False" />
            </TabControl>

            <TextBlock Text="ListBox + ScrollBar" Style="{StaticResource SectionHeader}" />
            <ListBox x:Name="PartsList" Height="160" Width="280" HorizontalAlignment="Left" />

            <TextBlock Text="ToolTip" Style="{StaticResource SectionHeader}" />
            <Button Content="Hover to show ToolTip"
                    HorizontalAlignment="Left"
                    ToolTip="Young's Modulus E = 205 GPa (SS400)" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
