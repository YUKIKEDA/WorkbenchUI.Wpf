<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ChartsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Docking &amp; Charts"
                Title="Charts"
                Description="ScottPlot 5 integration synced to ThemeManager colors: ConvergenceMonitor, HistoryChart, FrequencyResponsePlot, HistogramChart, and raw WorkbenchPlot. Ctrl+Wheel zooms; left-drag pans."
                PackageName="WorkbenchUI.Wpf.Charts"
                NamespaceName="WorkbenchUI.Wpf.Charts" />

            <!-- Card 1: ConvergenceMonitor -->
            <controls:ControlExample x:Name="ConvergenceExample"
                                     HeaderText="ConvergenceMonitor (Streaming Solver Residuals)"
                                     Description="Thread-safe ConvergenceSeries.Append(residual) updates logarithmic residual traces throttled at ~100 ms with a dashed convergence Threshold.">
                <wb:ConvergenceMonitor x:Name="Convergence"
                                       Height="260"
                                       Threshold="1e-6"
                                       XLabel="Iteration"
                                       YLabel="Residual" />

                <controls:ControlExample.Options>
                    <StackPanel>
                        <Button x:Name="SolveButton"
                                Content="Run Solver"
                                Style="{DynamicResource Wb.Button.Accent}"
                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Play}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"
                                Click="OnSolveClick" />
                        <Button x:Name="StopButton"
                                Content="Stop"
                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Stop}"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                Margin="0,0,0,12"
                                Click="OnStopClick" />

                        <TextBlock Text="Status" Style="{StaticResource Gallery.OptionLabel}" Margin="0,0,0,4" />
                        <TextBlock x:Name="SolveStatus"
                                   Text="Idle"
                                   FontFamily="{DynamicResource Wb.FontFamily.Monospace}"
                                   FontSize="{DynamicResource Wb.FontSize.S}"
                                   Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
                    </StackPanel>
                </controls:ControlExample.Options>
            </controls:ControlExample>

            <!-- Card 2: HistoryChart -->
            <controls:ControlExample x:Name="HistoryExample"
                                     HeaderText="HistoryChart (Load–Displacement &amp; Time History)"
                                     Description="Bind ChartSeries collections to SeriesSource with interactive crosshair coordinate readouts.">
                <wb:HistoryChart x:Name="History"
                                 Height="280"
                                 XLabel="Displacement [mm]"
                                 YLabel="Load [kN]" />
            </controls:ControlExample>

            <!-- Card 3: FrequencyResponsePlot -->
            <controls:ControlExample x:Name="FrfExample"
                                     HeaderText="FrequencyResponsePlot (Bode Magnitude &amp; Phase)"
                                     Description="Two-tier frequency response layout with synchronized logarithmic frequency X-axes.">
                <wb:FrequencyResponsePlot x:Name="Frf"
                                          Height="340"
                                          ShowPhase="{Binding IsChecked, ElementName=PhaseToggle}"
                                          MagnitudeInDecibels="{Binding IsChecked, ElementName=DecibelToggle}"
                                          XLabel="Frequency [Hz]" />

                <controls:ControlExample.Options>
                    <StackPanel>
                        <wb:ToggleSwitch x:Name="PhaseToggle" Content="Show Phase" IsChecked="True" />
                        <wb:ToggleSwitch x:Name="DecibelToggle" Content="dB Scale" IsChecked="True" Margin="0,10,0,0" />
                    </StackPanel>
                </controls:ControlExample.Options>
            </controls:ControlExample>

            <!-- Card 4: HistogramChart -->
            <controls:ControlExample x:Name="HistogramExample"
                                     HeaderText="HistogramChart (Stress Distribution)"
                                     Description="Bins large numeric arrays automatically with adjustable BinCount and probability density normalization.">
                <wb:HistogramChart x:Name="Histogram"
                                   Height="250"
                                   BinCount="{Binding Value, ElementName=BinSlider}"
                                   Normalize="{Binding IsChecked, ElementName=NormalizeToggle}"
                                   XLabel="von Mises stress [MPa]" />

                <controls:ControlExample.Options>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Gallery.OptionLabel}"
                                   Margin="0,0,0,4"
                                   Text="{Binding Value, ElementName=BinSlider, StringFormat='BinCount: {0:0}'}" />
                        <Slider x:Name="BinSlider" Minimum="5" Maximum="60" Value="24"
                                TickFrequency="1" IsSnapToTickEnabled="True" />

                        <wb:ToggleSwitch x:Name="NormalizeToggle"
                                         Content="Normalize to Density"
                                         Margin="0,14,0,0" />
                    </StackPanel>
                </controls:ControlExample.Options>
            </controls:ControlExample>

            <!-- Card 5: Raw WorkbenchPlot -->
            <controls:ControlExample x:Name="RawPlotExample"
                                     HeaderText="WorkbenchPlot (Direct ScottPlot 5 API)"
                                     Description="Use WorkbenchPlot when full ScottPlot 5 API flexibility is needed while retaining automatic Dark/Light &amp; accent theme synchronization.">
                <wb:WorkbenchPlot x:Name="FreePlot" Height="250" />
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
