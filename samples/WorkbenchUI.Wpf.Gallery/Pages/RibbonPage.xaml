<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.RibbonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="1020" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Navigation &amp; Workflow"
                Title="WorkbenchRibbon"
                Description="Workflow-ordered engineering command ribbon with tabs, labeled groups, large/small button styles (Wb.Ribbon.Button.*), SplitButtons, application menu, and auxiliary slot."
                PackageName="WorkbenchUI.Wpf"
                NamespaceName="WorkbenchUI.Wpf.Controls" />

            <controls:ControlExample x:Name="RibbonExample"
                                     HeaderText="CAE Workflow Command Ribbon (Model → Analysis → Results → View)"
                                     Description="Click tabs, ApplicationMenu ('File'), SplitButtons, and ToggleButtons to inspect commands in the live action log below.">
                <StackPanel>
                    <Border BorderBrush="{DynamicResource Wb.Brush.Border.Default}" BorderThickness="1" CornerRadius="3">
                        <wb:WorkbenchRibbon x:Name="DemoRibbon" ApplicationLabel="File">
                            <wb:WorkbenchRibbon.ApplicationMenu>
                                <ContextMenu>
                                    <MenuItem Header="_New" Click="OnAction" Tag="New" />
                                    <MenuItem Header="_Open..." Click="OnAction" Tag="Open" />
                                    <MenuItem Header="_Save" Click="OnAction" Tag="Save" />
                                    <Separator />
                                    <MenuItem Header="Se_ttings..." Click="OnAction" Tag="Settings" />
                                </ContextMenu>
                            </wb:WorkbenchRibbon.ApplicationMenu>
                            <wb:WorkbenchRibbon.AuxiliaryContent>
                                <Button Style="{DynamicResource Wb.Button.Icon}"
                                        wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Help}"
                                        ToolTip="Help" Click="OnAction" Tag="Help" />
                            </wb:WorkbenchRibbon.AuxiliaryContent>

                            <wb:WorkbenchRibbonTab Header="Model">
                                <wb:WorkbenchRibbonGroup Header="Templates">
                                    <Button Style="{DynamicResource Wb.Ribbon.Button.Large}"
                                            wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.NewFile}"
                                            Content="New" Click="OnAction" Tag="New Model" />
                                    <Button Style="{DynamicResource Wb.Ribbon.Button.Large}"
                                            wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.FolderOpen}"
                                            Content="Open" Click="OnAction" Tag="Open Model" />
                                </wb:WorkbenchRibbonGroup>
                                <wb:WorkbenchRibbonGroup Header="Mesh">
                                    <Button Style="{DynamicResource Wb.Ribbon.Button.Large}"
                                            wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Mesh}"
                                            Content="Remesh" Click="OnAction" Tag="Remesh" />
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Style="{DynamicResource Wb.Ribbon.Button.Small}"
                                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Add}"
                                                Content="Refine" Click="OnAction" Tag="Refine Mesh" />
                                        <Button Style="{DynamicResource Wb.Ribbon.Button.Small}"
                                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Remove}"
                                                Content="Coarsen" Click="OnAction" Tag="Coarsen Mesh" />
                                        <Button Style="{DynamicResource Wb.Ribbon.Button.Small}"
                                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Grid}"
                                                Content="Quality Check" Click="OnAction" Tag="Quality Check" />
                                    </StackPanel>
                                </wb:WorkbenchRibbonGroup>
                                <wb:WorkbenchRibbonGroup Header="Material">
                                    <ComboBox Width="140" SelectedIndex="0" VerticalAlignment="Center" Margin="4,0">
                                        <ComboBoxItem Content="Steel SS400" />
                                        <ComboBoxItem Content="Aluminum A5052" />
                                        <ComboBoxItem Content="Titanium Ti-6Al-4V" />
                                    </ComboBox>
                                </wb:WorkbenchRibbonGroup>
                            </wb:WorkbenchRibbonTab>

                            <wb:WorkbenchRibbonTab Header="Analysis">
                                <wb:WorkbenchRibbonGroup Header="Execution">
                                    <wb:SplitButton x:Name="RunSplit"
                                                    Style="{DynamicResource Wb.Ribbon.SplitButton.Large.Accent}"
                                                    wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Play}"
                                                    Content="Run Solve" Click="OnAction" Tag="Run Solve (Local)">
                                        <wb:SplitButton.DropDownMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Run Locally" Click="OnAction" Tag="Run Locally" />
                                                <MenuItem Header="Submit as Job..." Click="OnAction" Tag="Submit as Job" />
                                            </ContextMenu>
                                        </wb:SplitButton.DropDownMenu>
                                    </wb:SplitButton>
                                    <Button Style="{DynamicResource Wb.Ribbon.Button.Large}"
                                            wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Stop}"
                                            Content="Abort" IsEnabled="False" />
                                </wb:WorkbenchRibbonGroup>
                                <wb:WorkbenchRibbonGroup Header="Jobs">
                                    <Button Style="{DynamicResource Wb.Ribbon.Button.Large}"
                                            wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Server}"
                                            Content="Job Monitor" Click="OnAction" Tag="Job Monitor" />
                                </wb:WorkbenchRibbonGroup>
                            </wb:WorkbenchRibbonTab>

                            <wb:WorkbenchRibbonTab Header="Results">
                                <wb:WorkbenchRibbonGroup Header="Contours">
                                    <Button Style="{DynamicResource Wb.Ribbon.Button.Large}"
                                            wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Contour}"
                                            Content="Stress" Click="OnAction" Tag="Stress Contour" />
                                    <Button Style="{DynamicResource Wb.Ribbon.Button.Large}"
                                            wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Vector}"
                                            Content="Displacement" Click="OnAction" Tag="Displacement Vector" />
                                </wb:WorkbenchRibbonGroup>
                                <wb:WorkbenchRibbonGroup Header="Measure">
                                    <ToggleButton Style="{DynamicResource Wb.Ribbon.Toggle.Large}"
                                                  wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Probe}"
                                                  Content="Probe" Click="OnAction" Tag="Probe" />
                                    <Button Style="{DynamicResource Wb.Ribbon.Button.Large}"
                                            wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Delete}"
                                            Content="Clear Annotations" Click="OnAction" Tag="Clear Annotations" />
                                </wb:WorkbenchRibbonGroup>
                            </wb:WorkbenchRibbonTab>

                            <wb:WorkbenchRibbonTab Header="View">
                                <wb:WorkbenchRibbonGroup Header="Overlays">
                                    <StackPanel VerticalAlignment="Center">
                                        <ToggleButton Style="{DynamicResource Wb.Ribbon.Toggle.Small}"
                                                      wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Grid}"
                                                      Content="Edges" IsChecked="True" Click="OnAction" Tag="Edges" />
                                        <ToggleButton Style="{DynamicResource Wb.Ribbon.Toggle.Small}"
                                                      wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Cube}"
                                                      Content="Undeformed" Click="OnAction" Tag="Undeformed" />
                                    </StackPanel>
                                </wb:WorkbenchRibbonGroup>
                                <wb:WorkbenchRibbonGroup Header="Camera">
                                    <Button Style="{DynamicResource Wb.Ribbon.Button.Large}"
                                            wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.ZoomToFit}"
                                            Content="Fit" Click="OnAction" Tag="Fit to View" />
                                    <Button Style="{DynamicResource Wb.Ribbon.Button.Large}"
                                            wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Camera}"
                                            Content="Default View" Click="OnAction" Tag="Default View" />
                                </wb:WorkbenchRibbonGroup>
                            </wb:WorkbenchRibbonTab>
                        </wb:WorkbenchRibbon>
                    </Border>

                    <Border Background="{DynamicResource Wb.Brush.Surface.Panel}"
                            BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Action Log" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock x:Name="ActionLog"
                                       Foreground="{DynamicResource Wb.Brush.Text.Secondary}"
                                       FontFamily="{DynamicResource Wb.FontFamily.Monospace}"
                                       FontSize="{DynamicResource Wb.FontSize.S}"
                                       Text="(Click any ribbon command to inspect its invoked tag here)" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
