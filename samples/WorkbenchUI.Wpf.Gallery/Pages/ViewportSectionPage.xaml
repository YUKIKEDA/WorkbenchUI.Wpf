<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ViewportSectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="3D Viewport"
                Title="Section Cut"
                Description="GPU clipping plane via WorkbenchViewport.SectionPlane with application-computed interior slice mesh (IsClippable=false) and clip-aware face picking."
                PackageName="WorkbenchUI.Wpf.Viewport3D"
                NamespaceName="WorkbenchUI.Wpf.Viewport3D" />

            <Border Style="{StaticResource Gallery.CardSurface}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,6" ItemHeight="28">
                        <wb:ToggleSwitch x:Name="ClipToggle" Content="Section Cut" IsChecked="True"
                                         AutomationProperties.AutomationId="ClipToggle"
                                         Checked="OnSectionOptionChanged" Unchecked="OnSectionOptionChanged" />
                        <TextBlock Text="Normal Axis:" VerticalAlignment="Center" Margin="20,0,8,0" />
                        <ComboBox x:Name="AxisCombo" MinWidth="70" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="AxisCombo"
                                  SelectionChanged="OnSectionOptionChanged">
                            <ComboBoxItem Content="X" IsSelected="True" />
                            <ComboBoxItem Content="Y" />
                            <ComboBoxItem Content="Z" />
                        </ComboBox>
                        <TextBlock Text="Offset:" VerticalAlignment="Center" Margin="20,0,8,0" />
                        <Slider x:Name="OffsetSlider" Width="180" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="OffsetSlider"
                                Minimum="-48" Maximum="48" Value="0"
                                ValueChanged="OnSectionOptionChanged" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                                   AutomationProperties.AutomationId="OffsetText"
                                   Text="{Binding Value, ElementName=OffsetSlider, StringFormat={}{0:0} mm}" />
                        <wb:ToggleSwitch x:Name="FlipToggle" Content="Flip" Margin="20,0,0,0"
                                         AutomationProperties.AutomationId="FlipToggle"
                                         Checked="OnSectionOptionChanged" Unchecked="OnSectionOptionChanged" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,10" ItemHeight="28">
                        <wb:ToggleSwitch x:Name="IndicatorToggle" Content="Plane Indicator" IsChecked="True"
                                         AutomationProperties.AutomationId="IndicatorToggle" />
                        <wb:ToggleSwitch x:Name="SliceToggle" Content="Section Slice (App Cap)" IsChecked="True" Margin="20,0,0,0"
                                         AutomationProperties.AutomationId="SliceToggle"
                                         Checked="OnSectionOptionChanged" Unchecked="OnSectionOptionChanged" />
                        <wb:ToggleSwitch x:Name="ContourToggle" Content="Contours" IsChecked="True" Margin="20,0,0,0" />
                        <Button Content="Fit" Click="OnFitClick" MinWidth="60" Margin="20,0,0,0" />
                        <Button Content="Clear Selection" Click="OnClearSelectionClick" Margin="12,0,0,0"
                                AutomationProperties.AutomationId="ClearSelectionButton" />
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="{DynamicResource Wb.Brush.Border.Default}" BorderThickness="1">
                            <wb:WorkbenchViewport x:Name="Viewport"
                                                  Height="420"
                                                  PickMode="Face"
                                                  ShowSectionPlaneIndicator="{Binding IsChecked, ElementName=IndicatorToggle}"
                                                  ShowContours="{Binding IsChecked, ElementName=ContourToggle}" />
                        </Border>

                        <wb:ColorMapLegend x:Name="Legend"
                                           Grid.Column="1"
                                           Height="280"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Title="σ_vM [MPa]" />
                    </Grid>

                    <TextBlock x:Name="SelectionSummary" Style="{StaticResource Gallery.HintText}" Margin="0,8,0,0"
                               AutomationProperties.AutomationId="SelectionSummary"
                               Text="Parts: 0, Faces: 0, Nodes: 0" />
                    <TextBlock x:Name="RendererInfo" Style="{StaticResource Gallery.HintText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Gallery.CardSurface}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Clipping &amp; Lamé Model Notes" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Gallery.HintText}" Margin="0,0,0,6"
                               Text="Clipping uses SV_ClipDistance across all passes (contours, edges, highlights, and GPU ID picking agree). Application-computed cross-section slice meshes opt out with IsClippable=false." />
                    <TextBlock Style="{StaticResource Gallery.HintText}"
                               Text="Lamé thick-walled cylinder solution peaks at the inner wall. Flip reverses the normal sign to expose the opposite half-space." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
