<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.InputsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Wb.FontSize.L}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Text="Inputs &amp; Buttons"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />

            <TextBlock Text="Button (4 Variants: Accent / Standard / Subtle / Danger)" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Accent" Style="{DynamicResource Wb.Button.Accent}" Margin="0,0,8,0" />
                <Button Content="Standard" Margin="0,0,8,0" />
                <Button Content="Subtle" Style="{DynamicResource Wb.Button.Subtle}" Margin="0,0,8,0" />
                <Button Content="Danger" Style="{DynamicResource Wb.Button.Danger}" Margin="0,0,8,0" />
                <Button Content="Disabled" IsEnabled="False" Margin="0,0,8,0" />
                <Button Content="Accent Disabled" Style="{DynamicResource Wb.Button.Accent}" IsEnabled="False" />
            </StackPanel>

            <TextBlock Text="With Icons (wb:ButtonAssist.Icon)" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Run" Style="{DynamicResource Wb.Button.Accent}"
                        wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Play}" Margin="0,0,8,0" />
                <Button Content="Save"
                        wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Save}" Margin="0,0,8,0" />
                <Button Content="Filter" Style="{DynamicResource Wb.Button.Subtle}"
                        wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Filter}" Margin="0,0,8,0" />
                <Button Content="Delete" Style="{DynamicResource Wb.Button.Danger}"
                        wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Delete}" Margin="0,0,8,0" />
                <Button Style="{DynamicResource Wb.Button.Icon}"
                        wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Settings}"
                        ToolTip="Settings" />
            </StackPanel>

            <TextBlock Text="CheckBox / RadioButton" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,32,0">
                    <CheckBox Content="Checked" IsChecked="True" Margin="0,2" />
                    <CheckBox Content="Unchecked" Margin="0,2" />
                    <CheckBox Content="Indeterminate" IsChecked="{x:Null}" IsThreeState="True" Margin="0,2" />
                    <CheckBox Content="Disabled" IsChecked="True" IsEnabled="False" Margin="0,2" />
                </StackPanel>
                <StackPanel>
                    <RadioButton Content="Option A" IsChecked="True" GroupName="Demo" Margin="0,2" />
                    <RadioButton Content="Option B" GroupName="Demo" Margin="0,2" />
                    <RadioButton Content="Disabled" IsEnabled="False" GroupName="Demo" Margin="0,2" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="TextBox" Style="{StaticResource SectionHeader}" />
            <StackPanel MaxWidth="320" HorizontalAlignment="Left">
                <TextBox Text="Editable text" Margin="0,2" />
                <TextBox Text="Read-only" IsReadOnly="True" Margin="0,2" />
                <TextBox Text="Disabled" IsEnabled="False" Margin="0,2" />
                <TextBox Margin="0,2"
                         ToolTipService.InitialShowDelay="200"
                         Text="{Binding Thickness, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="↑ Plate thickness [mm] (values outside 0–100 show a red validation border + tooltip)"
                           Foreground="{DynamicResource Wb.Brush.Text.Secondary}"
                           FontSize="{StaticResource Wb.FontSize.S}" />
            </StackPanel>

            <TextBlock Text="ComboBox" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="180" SelectedIndex="0" Margin="0,0,8,0">
                    <ComboBoxItem Content="Structural (Static)" />
                    <ComboBoxItem Content="Modal Analysis" />
                    <ComboBoxItem Content="Thermal Conduction" />
                    <ComboBoxItem Content="Thermal Stress" />
                </ComboBox>
                <ComboBox Width="180" IsEditable="True" Text="Editable" Margin="0,0,8,0">
                    <ComboBoxItem Content="Aluminum A5052" />
                    <ComboBoxItem Content="Steel SS400" />
                    <ComboBoxItem Content="Titanium Ti-6Al-4V" />
                </ComboBox>
                <ComboBox Width="120" SelectedIndex="0" IsEnabled="False">
                    <ComboBoxItem Content="Disabled" />
                </ComboBox>
            </StackPanel>

            <TextBlock Text="Slider / ProgressBar" Style="{StaticResource SectionHeader}" />
            <StackPanel MaxWidth="400" HorizontalAlignment="Left">
                <Slider x:Name="DemoSlider" Minimum="0" Maximum="100" Value="40" Margin="0,2" />
                <ProgressBar Value="{Binding ElementName=DemoSlider, Path=Value}" Margin="0,8,0,2" />
                <ProgressBar x:Name="IndeterminateBar" IsIndeterminate="True" Margin="0,8,0,2" />
                <CheckBox Content="Indeterminate Mode (IsIndeterminate)"
                          IsChecked="{Binding ElementName=IndeterminateBar, Path=IsIndeterminate}"
                          Margin="0,4" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
