<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.PathBoxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Engineering Inputs"
                Title="PathBox"
                Description="File and folder path selector combining editable text entry with built-in OpenFile, SaveFile, and Folder OS dialogs or custom BrowseRequested overrides."
                PackageName="WorkbenchUI.Wpf"
                NamespaceName="WorkbenchUI.Wpf.Controls" />

            <!-- Card 1: OpenFile / SaveFile / Folder Modes -->
            <controls:ControlExample x:Name="ModesExample"
                                     HeaderText="OpenFile, SaveFile &amp; Folder Modes"
                                     Description="Click the trailing ... button to open the OS dialog, or type a path directly into the textbox.">
                <Grid MaxWidth="560" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Mesh File" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <wb:PathBox x:Name="OpenPathBox"
                                Grid.Row="0" Grid.Column="1"
                                Mode="OpenFile"
                                DialogTitle="Open Mesh File"
                                Filter="Mesh files (*.msh;*.inp)|*.msh;*.inp|All files (*.*)|*.*"
                                SelectedPath="C:\Models\bracket_rev3.msh"
                                Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Text="Output Path" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <wb:PathBox x:Name="SavePathBox"
                                Grid.Row="1" Grid.Column="1"
                                Mode="SaveFile"
                                Filter="Result files (*.vtk)|*.vtk"
                                SelectedPath="C:\Results\stress_case1.vtk"
                                Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Text="Working Folder" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <wb:PathBox x:Name="FolderPathBox"
                                Grid.Row="2" Grid.Column="1"
                                Mode="Folder"
                                Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Text="Read-Only" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <wb:PathBox Grid.Row="3" Grid.Column="1"
                                IsReadOnly="True"
                                SelectedPath="C:\ProgramData\Workbench\defaults.cfg"
                                Margin="0,0,0,8" />

                    <TextBlock Grid.Row="4" Grid.Column="1"
                               FontFamily="{DynamicResource Wb.FontFamily.Monospace}"
                               FontSize="{DynamicResource Wb.FontSize.S}"
                               Foreground="{DynamicResource Wb.Brush.Text.Secondary}"
                               Text="{Binding ElementName=OpenPathBox, Path=SelectedPath, StringFormat='Mesh SelectedPath = {0}'}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </controls:ControlExample>

            <!-- Card 2: Custom BrowseRequested Hook -->
            <controls:ControlExample x:Name="CustomBrowseExample"
                                     HeaderText="Custom BrowseRequested Hook"
                                     Description="Handle BrowseRequested and set e.Handled = true to plug in a project vault browser, cloud picker, or test stub.">
                <StackPanel MaxWidth="540" HorizontalAlignment="Left">
                    <wb:PathBox x:Name="CustomPathBox"
                                Width="420"
                                HorizontalAlignment="Left"
                                SelectedPath="vault://projects/wing-rib/mesh-v4.msh"
                                BrowseRequested="CustomPathBox_BrowseRequested" />
                    <TextBlock x:Name="CustomBrowseStatus"
                               Text="Click ... to trigger BrowseRequested with e.Handled = true."
                               Style="{StaticResource Gallery.HintText}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
