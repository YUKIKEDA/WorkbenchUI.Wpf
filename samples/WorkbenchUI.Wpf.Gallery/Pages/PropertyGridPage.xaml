<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.PropertyGridPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="PropertyGrid"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <wb:PropertyGrid x:Name="Grid1" />
        </DockPanel>

        <StackPanel Grid.Column="1" Margin="24,36,0,0">
            <TextBlock Text="Demo Notes" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Wb.Brush.Text.Secondary}">
                <Run Text="• Collapse/expand categories by clicking headers" /><LineBreak />
                <Run Text="• Filter properties using the search box at the top" /><LineBreak />
                <Run Text="• Hover over a row to see its description tooltip" /><LineBreak />
                <Run Text="• &quot;Thickness&quot; uses IUnitProvider (displays mm, stores m)" /><LineBreak />
                <Run Text="• Changing &quot;Analysis Type&quot; dynamically swaps the rows below" /><LineBreak />
                <Run Text="• &quot;ID&quot; is read-only" />
            </TextBlock>
            <TextBlock x:Name="ValueMonitor"
                       Margin="0,16,0,0"
                       FontFamily="{StaticResource Wb.FontFamily.Monospace}"
                       Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
        </StackPanel>
    </Grid>
</UserControl>
