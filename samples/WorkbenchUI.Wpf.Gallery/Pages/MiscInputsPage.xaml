<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.MiscInputsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Wb.FontSize.L}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource Wb.FontSize.S}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left">

            <TextBlock Text="Misc Inputs &amp; Wizard" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />

            <TextBlock Text="CheckComboBox (Multi-select ComboBox)" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="240">
                    <TextBlock Text="Result Components (Select All + Count)" Margin="0,0,0,4" />
                    <wb:CheckComboBox x:Name="ComponentCombo"
                                      SummaryFormat="{}{0} component(s) selected"
                                      SelectAllContent="(Select All)"
                                      PlaceholderText="Select components..." />
                </StackPanel>
                <StackPanel Width="240" Margin="24,0,0,0">
                    <TextBlock Text="Load Cases (Default = Joined Names)" Margin="0,0,0,4" />
                    <wb:CheckComboBox x:Name="CaseCombo"
                                      DisplayMemberPath="Name"
                                      PlaceholderText="Select load cases..." />
                </StackPanel>
                <TextBlock x:Name="ComboInfo" Margin="24,20,0,0"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Bind an ObservableCollection to SelectedItems (TwoWay sync). Left shows SummaryFormat count + a Select All row; right shows the default comma-joined item names." />

            <TextBlock Text="MatrixBox (Matrix Input)" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <TextBlock Text="Orthotropic Elasticity [GPa] (3×3 Symmetric)" Margin="0,0,0,4" />
                    <wb:MatrixBox x:Name="StiffnessMatrix"
                                  Width="240"
                                  IsSymmetric="True"
                                  Format="G4" />
                </StackPanel>
                <StackPanel Margin="24,0,0,0">
                    <TextBlock Text="Coordinate Transform (3×3, No Headers)" Margin="0,0,0,4" />
                    <wb:MatrixBox x:Name="TransformMatrix"
                                  Width="220"
                                  Format="F2" />
                </StackPanel>
                <TextBlock x:Name="MatrixInfo" Margin="24,20,0,0"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource Wb.Brush.Text.Secondary}"
                           FontFamily="Consolas" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Values (double[,]) is replaced with a fresh array instance on each cell commit. Left has IsSymmetric=True so editing (i,j) automatically mirrors to (j,i)." />

            <TextBlock Text="KeyGestureBox (Shortcut Input)" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="240">
                    <TextBlock Text="Run Solver" Margin="0,0,0,4" />
                    <wb:KeyGestureBox x:Name="RunGestureBox"
                                      PlaceholderText="Press a key to assign..." />
                </StackPanel>
                <TextBlock x:Name="GestureInfo" Margin="24,20,0,0"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Focus and press a key combination to assign a KeyGesture (letter keys require modifiers; F1–F12 etc. work standalone). Click × to clear or press Esc to revert. Round-trips cleanly with KeyGestureConverter." />

            <TextBlock Text="Wizard / StepIndicator" Style="{StaticResource SectionHeader}" />
            <Border Background="{DynamicResource Wb.Brush.Surface.Panel}"
                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                    BorderThickness="1" CornerRadius="2" Padding="16"
                    Width="560" HorizontalAlignment="Left">
                <wb:Wizard x:Name="SetupWizard"
                           MinHeight="200"
                           BackButtonText="Back"
                           NextButtonText="Next"
                           FinishButtonText="Finish"
                           CancelButtonText="Cancel"
                           Navigating="SetupWizard_Navigating"
                           Finished="SetupWizard_Finished"
                           Cancelled="SetupWizard_Cancelled">
                    <wb:WizardStep Header="Analysis Type">
                        <StackPanel>
                            <TextBlock Text="Select the type of analysis to run." Margin="0,0,0,8" />
                            <RadioButton Content="Static Analysis" IsChecked="True" Margin="0,2" />
                            <RadioButton Content="Modal Analysis" Margin="0,2" />
                            <RadioButton Content="Transient Response" Margin="0,2" />
                        </StackPanel>
                    </wb:WizardStep>
                    <wb:WizardStep Header="Conditions">
                        <StackPanel>
                            <TextBlock Text="Configure analysis conditions." Margin="0,0,0,8" />
                            <CheckBox x:Name="ConditionCheck"
                                      Content="Boundary conditions verified (required to enable Next)"
                                      Checked="ConditionCheck_Changed"
                                      Unchecked="ConditionCheck_Changed" />
                        </StackPanel>
                    </wb:WizardStep>
                    <wb:WizardStep Header="Review">
                        <StackPanel>
                            <TextBlock Text="Review your settings and click Finish." Margin="0,0,0,8" />
                            <TextBlock Text="Analysis Type: Static Analysis / Boundary Conditions: Verified"
                                       Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
                        </StackPanel>
                    </wb:WizardStep>
                </wb:Wizard>
            </Border>
            <TextBlock x:Name="WizardInfo" Style="{StaticResource Hint}"
                       Text="CanGoNext is bound to the Step 2 checkbox (declarative disable), and the Navigating event can also cancel transitions just-in-time. The host handles Finished/Cancelled to close the dialog." />

            <Border Height="24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
