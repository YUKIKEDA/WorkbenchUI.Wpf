<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ModelTreePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="ModelTree"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Expand All" Click="OnExpandAll" />
                <Button Content="Collapse All" Click="OnCollapseAll" Margin="8,0,0,0" />
            </StackPanel>
            <wb:ModelTree x:Name="Tree" SelectionChanged="OnTreeSelectionChanged">
                <wb:ModelTree.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Zoom to Fit" />
                        <MenuItem Header="Isolate" />
                        <Separator />
                        <MenuItem Header="Rename" InputGestureText="F2" Click="OnRenameClick" />
                        <MenuItem Header="Delete" />
                    </ContextMenu>
                </wb:ModelTree.ContextMenu>
            </wb:ModelTree>
        </DockPanel>

        <StackPanel Grid.Column="1" Margin="24,36,0,0">
            <TextBlock Text="Demo Notes" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Wb.Brush.Text.Secondary}">
                <Run Text="• Single-click expand without chevrons or double-clicks" /><LineBreak />
                <Run Text="• Ctrl / Shift multi-selection and arrow keys (← / → to collapse / expand)" /><LineBreak />
                <Run Text="• Eye icon: clicking a parent propagates to all descendants;" /><LineBreak />
                <Run Text="  partially hidden children show a mixed (dimmed) parent icon" /><LineBreak />
                <Run Text="• Right-click selects the row and opens the context menu" /><LineBreak />
                <Run Text="• Press F2 or click Rename for inline editing" /><LineBreak />
                <Run Text="  (Enter commits / Esc cancels / blank names rejected; IRenamableNode only)" /><LineBreak />
                <Run Text="• &quot;Result Sets&quot; contains 2,000 nodes (to verify UI virtualization)" />
            </TextBlock>
            <TextBlock x:Name="SelectionInfo"
                       Margin="0,16,0,0"
                       Foreground="{DynamicResource Wb.Brush.Text.Secondary}"
                       Text="Selected: 0" />
        </StackPanel>
    </Grid>
</UserControl>
