<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ExpanderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Navigation &amp; Workflow"
                Title="Expander &amp; Containers"
                Badge="New"
                Description="Collapsible Expander sections for engineering property groups, GroupBox framing, and multi-layer surface containers."
                PackageName="WorkbenchUI.Wpf"
                NamespaceName="WorkbenchUI.Wpf.Controls" />

            <!-- Card 1: Expander -->
            <controls:ControlExample x:Name="ExpanderExample"
                                     HeaderText="Expander"
                                     Description="Compact collapsible sections ideal for inspector sidebars and solver settings.">
                <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                    <Expander x:Name="MaterialExpander"
                              Header="Material Properties"
                              IsExpanded="True"
                              Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Young's Modulus" VerticalAlignment="Center" />
                            <wb:NumericBox Grid.Column="1" Value="205" Unit="GPa" Margin="0,3" />
                            <TextBlock Grid.Row="1" Text="Poisson's Ratio" VerticalAlignment="Center" />
                            <wb:NumericBox Grid.Row="1" Grid.Column="1" Value="0.3" Minimum="0" Maximum="0.5" Increment="0.05" Margin="0,3" />
                            <TextBlock Grid.Row="2" Text="Density" VerticalAlignment="Center" />
                            <wb:NumericBox Grid.Row="2" Grid.Column="1" Value="7850" Unit="kg/m³" Margin="0,3" />
                        </Grid>
                    </Expander>

                    <Expander x:Name="MeshExpander" Header="Mesh Settings">
                        <StackPanel>
                            <TextBlock Text="Element size and growth rate parameters."
                                       Style="{StaticResource Gallery.HintText}"
                                       Margin="0,0,0,6" />
                            <wb:NumericBox Value="2.5" Unit="mm" Width="160" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <controls:ControlExample.Options>
                    <StackPanel>
                        <wb:ToggleSwitch Content="Material Expanded"
                                         IsChecked="{Binding ElementName=MaterialExpander, Path=IsExpanded, Mode=TwoWay}" />
                        <wb:ToggleSwitch Content="Mesh Expanded"
                                         Margin="0,10,0,0"
                                         IsChecked="{Binding ElementName=MeshExpander, Path=IsExpanded, Mode=TwoWay}" />
                        <wb:ToggleSwitch Content="IsEnabled"
                                         Margin="0,10,0,0"
                                         IsChecked="{Binding ElementName=MaterialExpander, Path=IsEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </controls:ControlExample.Options>
            </controls:ControlExample>

            <!-- Card 2: GroupBox & Surface Hierarchy -->
            <controls:ControlExample x:Name="GroupBoxExample"
                                     HeaderText="GroupBox &amp; Layered Surfaces"
                                     Description="Use GroupBox and semantic surface tokens (Window, Panel, Elevated) to establish clear visual hierarchy without decorative clutter.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Solver Termination">
                        <StackPanel>
                            <CheckBox Content="Max iterations limit" IsChecked="True" Margin="0,2" />
                            <wb:NumericBox Value="500" Increment="50" Margin="0,6,0,6" />
                            <CheckBox Content="Residual tolerance &lt; 1e-6" IsChecked="True" Margin="0,2" />
                        </StackPanel>
                    </GroupBox>

                    <Border Grid.Column="2"
                            Background="{DynamicResource Wb.Brush.Surface.Panel}"
                            BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="Surface.Panel" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border Background="{DynamicResource Wb.Brush.Surface.Elevated}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="12">
                                <TextBlock Text="Nested Surface.Elevated card for popups or highlighted sub-regions."
                                           Style="{StaticResource Gallery.HintText}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
