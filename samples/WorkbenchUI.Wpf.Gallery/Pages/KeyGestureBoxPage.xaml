<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.KeyGestureBoxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Engineering Inputs"
                Title="KeyGestureBox"
                Description="Shortcut capture input box that validates WPF KeyGestures, allows standalone function keys (F1–F12), reverts with Esc, and serializes via KeyGestureConverter."
                PackageName="WorkbenchUI.Wpf"
                NamespaceName="WorkbenchUI.Wpf.Controls" />

            <controls:ControlExample x:Name="GestureExample"
                                     HeaderText="Shortcut Capture"
                                     Description="Focus either box and press a key combination. Click the trailing × button to clear, or press Esc before blurring to restore.">
                <StackPanel>
                    <Grid MaxWidth="520" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Run Solver" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <wb:KeyGestureBox x:Name="RunGestureBox"
                                          Grid.Row="0" Grid.Column="1"
                                          PlaceholderText="Press a key to assign..."
                                          Margin="0,0,0,10" />

                        <TextBlock Grid.Row="1" Text="Fit Viewport" VerticalAlignment="Center" />
                        <wb:KeyGestureBox x:Name="FitGestureBox"
                                          Grid.Row="1" Grid.Column="1"
                                          PlaceholderText="Try F or Ctrl+0..." />
                    </Grid>

                    <TextBlock x:Name="GestureInfo"
                               Margin="0,12,0,0"
                               FontFamily="{DynamicResource Wb.FontFamily.Monospace}"
                               FontSize="{DynamicResource Wb.FontSize.S}"
                               Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
                </StackPanel>

                <controls:ControlExample.Options>
                    <StackPanel>
                        <Button Content="Reset to Defaults"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"
                                Click="ResetGestures_Click" />
                        <Button Content="Clear Both"
                                Style="{DynamicResource Wb.Button.Subtle}"
                                HorizontalAlignment="Left"
                                Click="ClearGestures_Click" />
                    </StackPanel>
                </controls:ControlExample.Options>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
