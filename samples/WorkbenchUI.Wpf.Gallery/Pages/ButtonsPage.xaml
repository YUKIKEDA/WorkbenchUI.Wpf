<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ButtonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ContextMenu x:Key="ViewPresetMenu">
            <MenuItem Header="Front" Click="MenuAction_Click" />
            <MenuItem Header="Top" Click="MenuAction_Click" />
            <MenuItem Header="Right" Click="MenuAction_Click" />
            <Separator />
            <MenuItem Header="Isometric" Click="MenuAction_Click" />
        </ContextMenu>

        <ContextMenu x:Key="SolveOptionsMenu">
            <MenuItem Header="Run (Current Settings)" Click="MenuAction_Click" />
            <MenuItem Header="Remesh and Run" Click="MenuAction_Click" />
            <MenuItem Header="Submit to Batch Queue..." Click="MenuAction_Click" />
        </ContextMenu>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Basic Inputs"
                Title="Button &amp; SplitButton"
                Badge="Updated"
                Description="Four-tier button hierarchy (Accent, Standard, Subtle, Danger), icon-only toolbar buttons via ButtonAssist.Icon, DropDownButton, and SplitButton."
                PackageName="WorkbenchUI.Wpf"
                NamespaceName="WorkbenchUI.Wpf.Controls" />

            <!-- Card 1: Interactive Playground -->
            <controls:ControlExample x:Name="PlaygroundExample"
                                     HeaderText="Interactive Button Playground"
                                     Description="Switch button style variant, icon visibility, enabled state, and label text dynamically.">
                <StackPanel HorizontalAlignment="Left">
                    <Button x:Name="DemoButton"
                            Content="Run Solver"
                            Style="{DynamicResource Wb.Button.Accent}"
                            wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Play}"
                            HorizontalAlignment="Left"
                            Click="DemoButton_Click" />
                    <TextBlock x:Name="ClickCounterText"
                               Text="Clicks: 0"
                               Style="{StaticResource Gallery.HintText}"
                               Margin="0,12,0,0" />
                </StackPanel>

                <controls:ControlExample.Options>
                    <StackPanel>
                        <TextBlock Text="Style Variant" Style="{StaticResource Gallery.OptionLabel}" Margin="0,0,0,4" />
                        <ComboBox x:Name="VariantCombo"
                                  SelectedIndex="0"
                                  SelectionChanged="VariantCombo_SelectionChanged">
                            <ComboBoxItem Content="Wb.Button.Accent" Tag="Wb.Button.Accent" />
                            <ComboBoxItem Content="Wb.Button (Standard)" Tag="Wb.Button" />
                            <ComboBoxItem Content="Wb.Button.Subtle" Tag="Wb.Button.Subtle" />
                            <ComboBoxItem Content="Wb.Button.Danger" Tag="Wb.Button.Danger" />
                        </ComboBox>

                        <TextBlock Text="Content Text" Style="{StaticResource Gallery.OptionLabel}" />
                        <TextBox x:Name="ButtonLabelBox"
                                 Text="Run Solver"
                                 TextChanged="ButtonLabelBox_TextChanged" />

                        <wb:ToggleSwitch x:Name="ShowIconSwitch"
                                         Content="Show Icon"
                                         IsChecked="True"
                                         Margin="0,12,0,0"
                                         Checked="ShowIconSwitch_Changed"
                                         Unchecked="ShowIconSwitch_Changed" />

                        <wb:ToggleSwitch Content="IsEnabled"
                                         Margin="0,10,0,0"
                                         IsChecked="{Binding ElementName=DemoButton, Path=IsEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </controls:ControlExample.Options>
            </controls:ControlExample>

            <!-- Card 2: Hierarchy & ButtonAssist.Icon -->
            <controls:ControlExample x:Name="VariantsExample"
                                     HeaderText="Button Variants &amp; Icon Composition"
                                     Description="Use Accent sparingly for primary workflow actions, Standard for normal commands, Subtle for secondary actions, and Danger for destructive operations.">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Accent" Style="{DynamicResource Wb.Button.Accent}" Margin="0,0,8,6" />
                        <Button Content="Standard" Margin="0,0,8,6" />
                        <Button Content="Subtle" Style="{DynamicResource Wb.Button.Subtle}" Margin="0,0,8,6" />
                        <Button Content="Danger" Style="{DynamicResource Wb.Button.Danger}" Margin="0,0,8,6" />
                        <Button Content="Disabled" IsEnabled="False" Margin="0,0,8,6" />
                        <Button Content="Accent Disabled" Style="{DynamicResource Wb.Button.Accent}" IsEnabled="False" Margin="0,0,0,6" />
                    </WrapPanel>

                    <WrapPanel>
                        <Button Content="Run" Style="{DynamicResource Wb.Button.Accent}"
                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Play}" Margin="0,0,8,6" />
                        <Button Content="Save"
                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Save}" Margin="0,0,8,6" />
                        <Button Content="Filter" Style="{DynamicResource Wb.Button.Subtle}"
                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Filter}" Margin="0,0,8,6" />
                        <Button Content="Delete" Style="{DynamicResource Wb.Button.Danger}"
                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Delete}" Margin="0,0,8,6" />
                        <Button Style="{DynamicResource Wb.Button.Icon}"
                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Settings}"
                                ToolTip="Settings"
                                Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </controls:ControlExample>

            <!-- Card 3: DropDownButton & SplitButton -->
            <controls:ControlExample x:Name="DropDownExample"
                                     HeaderText="DropDownButton &amp; SplitButton"
                                     Description="DropDownButton opens a ContextMenu on click; SplitButton separates a primary action from secondary dropdown choices (also supports F4 / Alt+Down).">
                <StackPanel>
                    <WrapPanel>
                        <wb:DropDownButton Content="View Presets"
                                           DropDownMenu="{StaticResource ViewPresetMenu}"
                                           Margin="0,0,10,6" />
                        <wb:SplitButton Content="Run Analysis"
                                        Click="SplitPrimary_Click"
                                        DropDownMenu="{StaticResource SolveOptionsMenu}"
                                        Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock x:Name="DropDownLogText"
                               Text="Click either button or open a menu option to see the invoked action."
                               Style="{StaticResource Gallery.HintText}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
