<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.WindowsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             mc:Ignorable="d">
    <!-- Root Grid allows ToastHost to overlay the entire page -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Windows (WorkbenchWindow / Dialogs / Toast / BusyOverlay)"
                           FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

                <!-- WorkbenchMessageBox -->
                <GroupBox Header="WorkbenchMessageBox" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Info (OK)" Click="InfoMessage_Click" />
                            <Button Content="Confirm (YesNoCancel)" Margin="8,0,0,0" Click="ConfirmMessage_Click" />
                            <Button Content="Warning (OKCancel)" Margin="8,0,0,0" Click="WarningMessage_Click" />
                            <Button Content="Error (OK)" Margin="8,0,0,0" Click="ErrorMessage_Click" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Wb.Brush.Text.Secondary}">
                            <Run Text="Result: " /><Run x:Name="MessageResult" Text="(none)" />
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Windows / Dialogs -->
                <GroupBox Header="WorkbenchWindow / WorkbenchDialogWindow" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open Tool Window" Click="OpenToolWindow_Click" />
                            <Button Content="Open Custom Dialog" Margin="8,0,0,0" Click="OpenDialog_Click" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Wb.Brush.Text.Secondary}">
                            <Run Text="• This Gallery itself uses WorkbenchWindow (custom window chrome)" /><LineBreak />
                            <Run Text="• Tool Window demonstrates embedding a Menu in the title bar via TitleBarContent" /><LineBreak />
                            <Run Text="• Custom Dialog subclasses WorkbenchDialogWindow with action buttons in Footer" />
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Toast -->
                <GroupBox Header="ToastHost" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Info" Click="InfoToast_Click" />
                        <Button Content="Success" Margin="8,0,0,0" Click="SuccessToast_Click" />
                        <Button Content="Warning" Margin="8,0,0,0" Click="WarningToast_Click" />
                        <Button Content="Error (8s)" Margin="8,0,0,0" Click="ErrorToast_Click" />
                    </StackPanel>
                </GroupBox>

                <!-- BusyOverlay -->
                <GroupBox Header="BusyOverlay">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Busy for 3s" Click="StartBusy_Click" />
                        </StackPanel>
                        <Grid Height="180">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Default display (spinner + text) -->
                            <wb:BusyOverlay x:Name="DefaultBusyOverlay" BusyText="Generating mesh...">
                                <Border Background="{DynamicResource Wb.Brush.Surface.Panel}"
                                        BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                        BorderThickness="1" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Default (Spinner)" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBox Text="Input disabled while busy" Margin="0,0,0,8" />
                                        <Button Content="Dummy Button" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </wb:BusyOverlay>

                            <!-- Custom content (ProgressDisplay) -->
                            <wb:BusyOverlay x:Name="ProgressBusyOverlay" Grid.Column="2">
                                <wb:BusyOverlay.BusyContent>
                                    <wb:ProgressDisplay x:Name="BusyProgress"
                                                        Width="260"
                                                        Text="Running analysis..."
                                                        IsIndeterminate="True" />
                                </wb:BusyOverlay.BusyContent>
                                <Border Background="{DynamicResource Wb.Brush.Surface.Panel}"
                                        BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                        BorderThickness="1" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="BusyContent = ProgressDisplay" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBox Text="Input disabled while busy" Margin="0,0,0,8" />
                                        <Button Content="Dummy Button" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </wb:BusyOverlay>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Toast notification host (bottom-right overlay) -->
        <wb:ToastHost x:Name="Toasts" />
    </Grid>
</UserControl>
