<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.WindowsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Feedback &amp; Windows"
                Title="Windows &amp; Dialogs"
                Description="Custom-chrome WorkbenchWindow (preserving native Aero snap/resize), WorkbenchDialogWindow with footer button bar, and themed WorkbenchMessageBox."
                PackageName="WorkbenchUI.Wpf"
                NamespaceName="WorkbenchUI.Wpf.Controls" />

            <!-- Card 1: WorkbenchMessageBox -->
            <controls:ControlExample x:Name="MessageBoxExample"
                                     HeaderText="WorkbenchMessageBox"
                                     Description="Modal themed message dialogs supporting OK, OKCancel, YesNo, and YesNoCancel with standard icons.">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="Info (OK)" Click="InfoMessage_Click" Margin="0,0,8,6" />
                        <Button Content="Confirm (YesNoCancel)" Click="ConfirmMessage_Click" Margin="0,0,8,6" />
                        <Button Content="Warning (OKCancel)" Click="WarningMessage_Click" Margin="0,0,8,6" />
                        <Button Content="Error (OK)" Style="{DynamicResource Wb.Button.Danger}" Click="ErrorMessage_Click" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0"
                               FontFamily="{DynamicResource Wb.FontFamily.Monospace}"
                               FontSize="{DynamicResource Wb.FontSize.S}"
                               Foreground="{DynamicResource Wb.Brush.Text.Secondary}">
                        <Run Text="Result: " /><Run x:Name="MessageResult" Text="(none)" />
                    </TextBlock>
                </StackPanel>
            </controls:ControlExample>

            <!-- Card 2: WorkbenchWindow & WorkbenchDialogWindow -->
            <controls:ControlExample x:Name="WindowExample"
                                     HeaderText="WorkbenchWindow &amp; WorkbenchDialogWindow"
                                     Description="Tool Window hosts an embedded Menu in WorkbenchWindow.TitleBarContent; Custom Dialog uses WorkbenchDialogWindow.Footer for right-aligned action buttons.">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="Open Tool Window"
                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Layout}"
                                Click="OpenToolWindow_Click"
                                Margin="0,0,8,6" />
                        <Button Content="Open Custom Dialog"
                                Style="{DynamicResource Wb.Button.Accent}"
                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Add}"
                                Click="OpenDialog_Click"
                                Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock x:Name="DialogResultText"
                               Text="Open either sample window to verify custom chrome and modal result handling."
                               Style="{StaticResource Gallery.HintText}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
