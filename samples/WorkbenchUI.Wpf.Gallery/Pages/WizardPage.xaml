<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.WizardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Navigation &amp; Workflow"
                Title="Wizard &amp; StepIndicator"
                Description="Multi-step guided configuration Wizard with declarative CanGoNext gating and standalone StepIndicator progress header."
                PackageName="WorkbenchUI.Wpf"
                NamespaceName="WorkbenchUI.Wpf.Controls" />

            <!-- Card 1: Multi-Step Wizard -->
            <controls:ControlExample x:Name="WizardExample"
                                     HeaderText="Interactive Analysis Setup Wizard"
                                     Description="CanGoNext is gated dynamically on Step 2 until the boundary condition checkbox is verified.">
                <StackPanel>
                    <Border Background="{DynamicResource Wb.Brush.Surface.Panel}"
                            BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="16"
                            Width="560"
                            HorizontalAlignment="Left">
                        <wb:Wizard x:Name="SetupWizard"
                                   MinHeight="200"
                                   BackButtonText="Back"
                                   NextButtonText="Next"
                                   FinishButtonText="Finish"
                                   CancelButtonText="Cancel"
                                   Navigating="SetupWizard_Navigating"
                                   Finished="SetupWizard_Finished"
                                   Cancelled="SetupWizard_Cancelled">
                            <wb:WizardStep Header="Analysis Type">
                                <StackPanel>
                                    <TextBlock Text="Select the type of analysis to run." Margin="0,0,0,8" />
                                    <RadioButton Content="Static Analysis" IsChecked="True" Margin="0,3" />
                                    <RadioButton Content="Modal Analysis" Margin="0,3" />
                                    <RadioButton Content="Transient Response" Margin="0,3" />
                                </StackPanel>
                            </wb:WizardStep>

                            <wb:WizardStep Header="Conditions">
                                <StackPanel>
                                    <TextBlock Text="Configure analysis conditions." Margin="0,0,0,8" />
                                    <CheckBox x:Name="ConditionCheck"
                                              Content="Boundary conditions verified (required to enable Next)"
                                              Checked="ConditionCheck_Changed"
                                              Unchecked="ConditionCheck_Changed" />
                                </StackPanel>
                            </wb:WizardStep>

                            <wb:WizardStep Header="Review">
                                <StackPanel>
                                    <TextBlock Text="Review your settings and click Finish." Margin="0,0,0,8" />
                                    <TextBlock Text="Analysis Type: Static Analysis · Boundary Conditions: Verified"
                                               Foreground="{DynamicResource Wb.Brush.Text.Secondary}" />
                                </StackPanel>
                            </wb:WizardStep>
                        </wb:Wizard>
                    </Border>

                    <TextBlock x:Name="WizardInfo"
                               Style="{StaticResource Gallery.HintText}"
                               Margin="0,10,0,0"
                               Text="Advance through the steps to observe CanGoNext validation and Finished/Cancelled events." />
                </StackPanel>
            </controls:ControlExample>

            <!-- Card 2: Standalone StepIndicator -->
            <controls:ControlExample x:Name="IndicatorExample"
                                     HeaderText="Standalone StepIndicator"
                                     Description="Display-only multi-stage step indicator driven by zero-based CurrentIndex.">
                <StackPanel>
                    <wb:StepIndicator x:Name="StandaloneIndicator"
                                      CurrentIndex="1"
                                      Margin="0,0,0,14">
                        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">Import CAD</sys:String>
                        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">Clean Geometry</sys:String>
                        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">Generate Mesh</sys:String>
                        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime">Run Solver</sys:String>
                    </wb:StepIndicator>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Previous" Click="PrevStep_Click" Margin="0,0,8,0" />
                        <Button Content="Next" Click="NextStep_Click" Margin="0,0,12,0" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Wb.FontFamily.Monospace}"
                                   FontSize="{DynamicResource Wb.FontSize.S}"
                                   Foreground="{DynamicResource Wb.Brush.Text.Secondary}"
                                   Text="{Binding ElementName=StandaloneIndicator, Path=CurrentIndex, StringFormat='CurrentIndex = {0}'}" />
                    </StackPanel>
                </StackPanel>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
