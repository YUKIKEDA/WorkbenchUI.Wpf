<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ColorMapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="ColorMap Legend" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

            <TextBlock Text="Contour Preview (pixel rendering via ColorScale.GetColor)"
                       FontWeight="SemiBold" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="{DynamicResource Wb.Brush.Border.Default}" BorderThickness="1"
                        VerticalAlignment="Top">
                    <Image x:Name="PreviewImage" Width="280" Height="200" Stretch="Fill" />
                </Border>
                <wb:ColorMapLegend x:Name="PreviewLegend"
                                   Height="200"
                                   Margin="16,0,0,0"
                                   Title="Stress [MPa]" />
                <StackPanel Margin="24,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="Color Map" Margin="0,0,0,4" />
                    <ComboBox x:Name="MapSelector" Width="140"
                              DisplayMemberPath="Name"
                              SelectionChanged="OnSettingsChanged" />
                    <CheckBox x:Name="LogCheck" Content="Logarithmic Scale" Margin="0,12,0,0"
                              Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                    <TextBlock Text="Discrete Levels (0 = Continuous)" Margin="0,12,0,4" />
                    <Slider x:Name="LevelSlider" Width="140" Minimum="0" Maximum="16"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="OnSettingsChanged" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource Wb.Brush.Text.Secondary}"
                               Text="{Binding ElementName=LevelSlider, Path=Value, StringFormat='Levels: {0:0}'}" />
                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Width="180"
                               Foreground="{DynamicResource Wb.Brush.Text.Secondary}"
                               Text="Out-of-range values (&lt; Min / &gt; Max) are shown in magenta and white (BelowRangeColor / AboveRangeColor)." />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Variations" FontWeight="SemiBold" Margin="0,24,0,8" />
            <StackPanel Orientation="Horizontal">
                <wb:ColorMapLegend x:Name="LegendContinuous" Height="180" Title="Continuous (Jet)" />
                <wb:ColorMapLegend x:Name="LegendDiscrete" Height="180" Margin="24,0,0,0" Title="Discrete (10 levels)" />
                <wb:ColorMapLegend x:Name="LegendLog" Height="180" Margin="24,0,0,0" Title="Log (1e-3 to 1e3)" />
                <wb:ColorMapLegend x:Name="LegendCoolwarm" Height="180" Margin="24,0,0,0" Title="Coolwarm (±50)" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
