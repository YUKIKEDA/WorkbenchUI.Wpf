<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ViewportProbePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource Wb.FontSize.S}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="3D Probe (Probing &amp; Annotations)" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="With PickMode=Probe, clicking resolves the exact hit via GPU ID picking, ray intersection, and barycentric interpolation, then pins a node-bound callout (chip + leader line). The demo uses a uniaxially loaded plate with a circular hole (Kirsch analytical solution, von Mises): probing the top/bottom hole rim reveals the 3× stress concentration (σ_vM = 3S = 300 MPa). Includes a reference ProbeLabelFormatter with physical units." />

            <WrapPanel Margin="0,12,0,8" ItemHeight="28">
                <wb:ToggleSwitch x:Name="ProbeToggle" Content="Probe Mode" IsChecked="True"
                                 AutomationProperties.AutomationId="ProbeToggle"
                                 Checked="OnProbeToggleChanged" Unchecked="OnProbeToggleChanged" />
                <wb:ToggleSwitch x:Name="AnimToggle" Content="Animate Vibration (Follow Deformation)" Margin="20,0,0,0"
                                 AutomationProperties.AutomationId="AnimToggle"
                                 Checked="OnAnimToggleChanged" Unchecked="OnAnimToggleChanged" />
                <Button Content="Top View" Click="OnTopViewClick" MinWidth="70" Margin="20,0,0,0"
                        AutomationProperties.AutomationId="TopViewButton" />
                <Button Content="Fit" Click="OnFitClick" MinWidth="60" Margin="12,0,0,0" />
            </WrapPanel>

            <!-- Viewport + Legend -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <wb:WorkbenchViewport x:Name="Viewport"
                                Grid.Column="0"
                                Height="420"
                                PickMode="Probe"
                                DeformationScale="0" />

                <wb:ColorMapLegend x:Name="Legend"
                                   Grid.Column="1"
                                   Height="280"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Title="σ_vM [MPa]" />
            </Grid>
            <TextBlock x:Name="RendererInfo" Style="{StaticResource Hint}" />

            <!-- Annotation list (reference implementation for removing/clearing annotations) -->
            <TextBlock Text="Annotations" FontWeight="SemiBold" Margin="0,12,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="AnnotationList" Grid.Column="0" MinHeight="72" MaxHeight="140"
                         AutomationProperties.AutomationId="AnnotationList"
                         DisplayMemberPath="Text" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <Button Content="Remove Selected" Click="OnRemoveAnnotationClick" MinWidth="110"
                            AutomationProperties.AutomationId="RemoveAnnotationButton" />
                    <Button Content="Clear All" Click="OnClearAnnotationsClick" MinWidth="110" Margin="0,8,0,0"
                            AutomationProperties.AutomationId="ClearAnnotationsButton" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="AnnotationSummary" Style="{StaticResource Hint}"
                       AutomationProperties.AutomationId="AnnotationSummary"
                       Text="Annotations: 0" />

            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                       Text="Annotations bind to (Mesh, NodeIndex) and track deformation (DeformationScale, harmonic animation, and transient playback) every frame. Callouts on hidden meshes, clipped nodes, or offscreen points hide automatically, and clicking empty background does nothing. Set Handled=true in ProbePicked to suppress the built-in callout and manage annotations manually." />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="Kirsch solution (uniaxial x-tension S = 100 MPa, hole radius a = 10 mm): σθ = 3S at θ = ±90° (stress concentration factor 3) and σθ = −S at θ = 0°/180°. The vibration displacement is an illustrative out-of-plane deflection for tracking demonstration." />

            <Border Height="24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
