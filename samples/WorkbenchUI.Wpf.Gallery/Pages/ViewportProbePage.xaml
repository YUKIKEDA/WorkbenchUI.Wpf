<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ViewportProbePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="3D Viewport"
                Title="Probing &amp; Annotations"
                Description="PickMode=Probe resolves exact surface coordinates, barycentric interpolated scalars, and pins deformation-tracking callout annotations (Kirsch plate hole SCF=3)."
                PackageName="WorkbenchUI.Wpf.Viewport3D"
                NamespaceName="WorkbenchUI.Wpf.Viewport3D" />

            <Border Style="{StaticResource Gallery.CardSurface}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,10" ItemHeight="28">
                        <wb:ToggleSwitch x:Name="ProbeToggle" Content="Probe Mode" IsChecked="True"
                                         AutomationProperties.AutomationId="ProbeToggle"
                                         Checked="OnProbeToggleChanged" Unchecked="OnProbeToggleChanged" />
                        <wb:ToggleSwitch x:Name="AnimToggle" Content="Animate Vibration (Follow Deformation)" Margin="20,0,0,0"
                                         AutomationProperties.AutomationId="AnimToggle"
                                         Checked="OnAnimToggleChanged" Unchecked="OnAnimToggleChanged" />
                        <Button Content="Top View" Click="OnTopViewClick" MinWidth="70" Margin="20,0,0,0"
                                AutomationProperties.AutomationId="TopViewButton" />
                        <Button Content="Fit" Click="OnFitClick" MinWidth="60" Margin="12,0,0,0" />
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="{DynamicResource Wb.Brush.Border.Default}" BorderThickness="1">
                            <wb:WorkbenchViewport x:Name="Viewport"
                                                  Height="420"
                                                  PickMode="Probe"
                                                  DeformationScale="0" />
                        </Border>

                        <wb:ColorMapLegend x:Name="Legend"
                                           Grid.Column="1"
                                           Height="280"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Title="σ_vM [MPa]" />
                    </Grid>

                    <TextBlock x:Name="RendererInfo" Style="{StaticResource Gallery.HintText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Annotation List & Notes -->
            <Border Style="{StaticResource Gallery.CardSurface}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Pinned Annotations" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="AnnotationList" Grid.Column="0" MinHeight="72" MaxHeight="140"
                                 AutomationProperties.AutomationId="AnnotationList"
                                 DisplayMemberPath="Text" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <Button Content="Remove Selected" Click="OnRemoveAnnotationClick" MinWidth="120"
                                    AutomationProperties.AutomationId="RemoveAnnotationButton" />
                            <Button Content="Clear All" Click="OnClearAnnotationsClick" MinWidth="120" Margin="0,8,0,0"
                                    AutomationProperties.AutomationId="ClearAnnotationsButton" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="AnnotationSummary" Style="{StaticResource Gallery.HintText}" Margin="0,8,0,8"
                               AutomationProperties.AutomationId="AnnotationSummary"
                               Text="Annotations: 0" />
                    <TextBlock Style="{StaticResource Gallery.HintText}"
                               Text="Annotations bind to (Mesh, NodeIndex) and follow DeformationScale, harmonic animation, and transient playback every frame while auto-hiding when clipped or offscreen." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
