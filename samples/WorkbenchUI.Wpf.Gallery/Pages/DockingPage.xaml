<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.DockingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Docking &amp; Charts"
                Title="Docking"
                Description="AvalonDock integration styled with semantic Dark/Light and dynamic Accent tokens, including floating windows, auto-hide tabs, and XML layout persistence."
                PackageName="WorkbenchUI.Wpf.Docking"
                NamespaceName="WorkbenchUI.Wpf.Docking">
                <controls:GalleryPageHeader.ActionContent>
                    <Button x:Name="LaunchButton"
                            Content="Open Shell Demo"
                            Style="{DynamicResource Wb.Button.Accent}"
                            wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Layout}"
                            Click="OnLaunchShell" />
                </controls:GalleryPageHeader.ActionContent>
            </controls:GalleryPageHeader>

            <wb:InfoBar Severity="Info"
                        Title="Separate Assembly"
                        Message="WorkbenchUI.Wpf.Docking builds on Dirkster.AvalonDock (MS-PL) in a separate package so apps without docking keep WorkbenchUI.Wpf zero-dependency."
                        IsClosable="False"
                        Margin="0,0,0,20" />

            <!-- Card 1: Full CAE Shell Launch & Features -->
            <controls:ControlExample x:Name="ThemeExample"
                                     HeaderText="WorkbenchDockTheme &amp; Multi-Pane CAE Shell"
                                     Description="Launch the multi-pane CAE shell window (Model Tree / Viewports / Properties / Legend / LogConsole) to test tab drag-and-drop, docking compasses, floating windows, and auto-hide pinning.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Gallery.CardSurface}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Included APIs" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="• WorkbenchDockTheme — VS2013 AvalonDock theme wired to DynamicResource tokens and live ThemeManager accent changes."
                                       Style="{StaticResource Gallery.HintText}" Margin="0,2" />
                            <TextBlock Text="• DockLayout — SaveToString / LoadFromString helpers resolving panes by ContentId callback."
                                       Style="{StaticResource Gallery.HintText}" Margin="0,2" />
                            <TextBlock Text="• Thin wrapper preserving DockingManager &amp; LayoutAnchorable directly."
                                       Style="{StaticResource Gallery.HintText}" Margin="0,2" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Gallery.CardSurface}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Try in Shell Demo" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="• Drag pane tabs onto docking compasses or drop outside to float."
                                       Style="{StaticResource Gallery.HintText}" Margin="0,2" />
                            <TextBlock Text="• Click the pin icon to auto-hide panes into side strips."
                                       Style="{StaticResource Gallery.HintText}" Margin="0,2" />
                            <TextBlock Text="• Press Ctrl+Tab to switch active documents &amp; tool windows."
                                       Style="{StaticResource Gallery.HintText}" Margin="0,2" />
                        </StackPanel>
                    </Border>
                </Grid>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
