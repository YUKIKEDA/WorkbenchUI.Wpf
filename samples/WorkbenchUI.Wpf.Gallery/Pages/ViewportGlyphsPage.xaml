<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ViewportGlyphsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="3D Viewport"
                Title="Vector Glyphs"
                Description="GPU-instanced low-poly 3D arrow fields driven by ViewportMesh.VectorValues with independent GlyphColorScale, GlyphScale, and GlyphStride decimation."
                PackageName="WorkbenchUI.Wpf.Viewport3D"
                NamespaceName="WorkbenchUI.Wpf.Viewport3D" />

            <Border Style="{StaticResource Gallery.CardSurface}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,6" ItemHeight="28">
                        <wb:ToggleSwitch x:Name="GlyphToggle" Content="Show Glyphs" IsChecked="True"
                                         AutomationProperties.AutomationId="GlyphToggle"
                                         Checked="OnGlyphToggleChanged" Unchecked="OnGlyphToggleChanged" />
                        <wb:ToggleSwitch x:Name="ClipToggle" Content="Section Cut" Margin="20,0,0,0"
                                         AutomationProperties.AutomationId="ClipToggle"
                                         Checked="OnClipToggleChanged" Unchecked="OnClipToggleChanged" />
                        <wb:ToggleSwitch x:Name="AnimToggle" Content="Animate Vibration (Follow Deformation)" Margin="20,0,0,0"
                                         AutomationProperties.AutomationId="AnimToggle"
                                         Checked="OnAnimToggleChanged" Unchecked="OnAnimToggleChanged" />
                        <Button Content="Fit" Click="OnFitClick" MinWidth="60" Margin="20,0,0,0" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,10" ItemHeight="30">
                        <TextBlock Text="Scale:" VerticalAlignment="Center" />
                        <Slider x:Name="ScaleSlider" Width="180" Minimum="0.2" Maximum="3.0" Value="1.0"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                AutomationProperties.AutomationId="ScaleSlider"
                                ValueChanged="OnScaleChanged" />
                        <TextBlock x:Name="ScaleLabel" Text="×1.0" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="48" />
                        <TextBlock Text="Stride:" VerticalAlignment="Center" Margin="20,0,0,0" />
                        <ComboBox x:Name="StrideCombo" Width="72" Margin="8,0,0,0" SelectedIndex="2"
                                  AutomationProperties.AutomationId="StrideCombo"
                                  SelectionChanged="OnStrideChanged">
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="8" />
                            <ComboBoxItem Content="16" />
                        </ComboBox>
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="{DynamicResource Wb.Brush.Border.Default}" BorderThickness="1">
                            <wb:WorkbenchViewport x:Name="Viewport"
                                                  Height="440"
                                                  DeformationScale="0" />
                        </Border>

                        <wb:ColorMapLegend x:Name="GlyphLegend"
                                           Grid.Column="1"
                                           Height="280"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Title="|u| [mm]" />
                    </Grid>

                    <TextBlock x:Name="RendererInfo" Style="{StaticResource Gallery.HintText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Gallery.CardSurface}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Vector Field Notes" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Gallery.HintText}"
                               Text="Arrows originate at mesh nodes (decimated by GlyphStride), respect SectionPlane clipping, and track Displacements in the vertex shader during vibration animation." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
