<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ViewportGlyphsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource Wb.FontSize.S}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="3D Glyphs (Vector Glyphs)" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Renders vector fields supplied via ViewportMesh.VectorValues (3 components per node) as GPU-instanced low-poly 3D arrows. Arrow length = |v| × GlyphScale, and color = |v| mapped through GlyphColorScale (independent of the contour ColorScale). The demo shows the radial displacement field u(r) = Ar + B/r of a pressurized thick-walled cylinder (Lamé analytical solution): all arrows point radially outward and are longest on the inner bore." />

            <WrapPanel Margin="0,12,0,4" ItemHeight="28">
                <wb:ToggleSwitch x:Name="GlyphToggle" Content="Show Glyphs" IsChecked="True"
                                 AutomationProperties.AutomationId="GlyphToggle"
                                 Checked="OnGlyphToggleChanged" Unchecked="OnGlyphToggleChanged" />
                <wb:ToggleSwitch x:Name="ClipToggle" Content="Section Cut" Margin="20,0,0,0"
                                 AutomationProperties.AutomationId="ClipToggle"
                                 Checked="OnClipToggleChanged" Unchecked="OnClipToggleChanged" />
                <wb:ToggleSwitch x:Name="AnimToggle" Content="Animate Vibration (Follow Deformation)" Margin="20,0,0,0"
                                 AutomationProperties.AutomationId="AnimToggle"
                                 Checked="OnAnimToggleChanged" Unchecked="OnAnimToggleChanged" />
                <Button Content="Fit" Click="OnFitClick" MinWidth="60" Margin="20,0,0,0" />
            </WrapPanel>

            <WrapPanel Margin="0,4,0,8" ItemHeight="30">
                <TextBlock Text="Scale:" VerticalAlignment="Center" />
                <Slider x:Name="ScaleSlider" Width="180" Minimum="0.2" Maximum="3.0" Value="1.0"
                        VerticalAlignment="Center" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="ScaleSlider"
                        ValueChanged="OnScaleChanged" />
                <TextBlock x:Name="ScaleLabel" Text="×1.0" VerticalAlignment="Center" Margin="8,0,0,0"
                           MinWidth="48" />
                <TextBlock Text="Stride:" VerticalAlignment="Center" Margin="20,0,0,0" />
                <ComboBox x:Name="StrideCombo" Width="72" Margin="8,0,0,0" SelectedIndex="2"
                          AutomationProperties.AutomationId="StrideCombo"
                          SelectionChanged="OnStrideChanged">
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="4" />
                    <ComboBoxItem Content="8" />
                    <ComboBoxItem Content="16" />
                </ComboBox>
            </WrapPanel>

            <!-- Viewport + Glyph Legend -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <wb:WorkbenchViewport x:Name="Viewport"
                                Grid.Column="0"
                                Height="440"
                                DeformationScale="0" />

                <wb:ColorMapLegend x:Name="GlyphLegend"
                                   Grid.Column="1"
                                   Height="280"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Title="|u| [mm]" />
            </Grid>
            <TextBlock x:Name="RendererInfo" Style="{StaticResource Hint}" />

            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                       Text="Arrows originate at mesh nodes and can be decimated with GlyphStride. With a section plane active, arrows on clipped nodes are hidden together with the mesh (respecting IsClippable). During vibration animation, the same array is passed to Displacements so arrow bases track the deformed surface in the vertex shader without rebuilding instance data. Bind GlyphColorScale to ColorMapLegend for a dedicated glyph legend." />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="Lamé solution (internal pressure p = 100 MPa, a = 30 / b = 50 mm, E = 200 GPa, ν = 0.3): u(r) = (pa² / E(b²−a²))·((1−ν)r + (1+ν)b²/r). Inner bore u(30) ≈ 0.0364 mm and outer wall u(50) ≈ 0.0281 mm, so arrows are both longer and hotter at the inner surface." />

            <Border Height="24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
