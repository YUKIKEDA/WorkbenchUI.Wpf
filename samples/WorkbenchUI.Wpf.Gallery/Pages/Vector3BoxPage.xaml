<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.Vector3BoxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Engineering Inputs"
                Title="Vector3Box"
                Description="Three-axis XYZ vector input built on NumericBox with nullable components, shared unit display, formatting, and range constraints."
                PackageName="WorkbenchUI.Wpf"
                NamespaceName="WorkbenchUI.Wpf.Controls" />

            <!-- Card 1: Interactive Playground -->
            <controls:ControlExample x:Name="PlaygroundExample"
                                     HeaderText="Interactive Vector3Box Playground"
                                     Description="Follows the same nullable convention as NumericBox (blank = null) with uniform Format, Unit, and bounds across X, Y, and Z.">
                <StackPanel HorizontalAlignment="Left">
                    <wb:Vector3Box x:Name="ForceVector"
                                   MaxWidth="500"
                                   HorizontalAlignment="Left"
                                   X="0"
                                   Y="0"
                                   Z="-9.8"
                                   Unit="m/s²"
                                   Format="G4" />

                    <Border Background="{DynamicResource Wb.Brush.Surface.Panel}"
                            BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="10,6"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock FontFamily="{DynamicResource Wb.FontFamily.Monospace}"
                                   FontSize="{DynamicResource Wb.FontSize.S}">
                            <Run Text="Value = (" /><Run Text="{Binding ElementName=ForceVector, Path=X, TargetNullValue=null}" /><Run Text=", " /><Run Text="{Binding ElementName=ForceVector, Path=Y, TargetNullValue=null}" /><Run Text=", " /><Run Text="{Binding ElementName=ForceVector, Path=Z, TargetNullValue=null}" /><Run Text=")" />
                        </TextBlock>
                    </Border>
                </StackPanel>

                <controls:ControlExample.Options>
                    <StackPanel>
                        <TextBlock Text="Unit" Style="{StaticResource Gallery.OptionLabel}" Margin="0,0,0,4" />
                        <ComboBox x:Name="UnitCombo" SelectedIndex="0" SelectionChanged="UnitCombo_SelectionChanged">
                            <ComboBoxItem Content="m/s²" />
                            <ComboBoxItem Content="N" />
                            <ComboBoxItem Content="mm" />
                            <ComboBoxItem Content="(none)" Tag="" />
                        </ComboBox>

                        <TextBlock Text="Format" Style="{StaticResource Gallery.OptionLabel}" />
                        <ComboBox x:Name="FormatCombo" SelectedIndex="0" SelectionChanged="FormatCombo_SelectionChanged">
                            <ComboBoxItem Content="G4" />
                            <ComboBoxItem Content="F2" />
                            <ComboBoxItem Content="E2" />
                        </ComboBox>

                        <wb:ToggleSwitch Content="IsReadOnly"
                                         Margin="0,12,0,0"
                                         IsChecked="{Binding ElementName=ForceVector, Path=IsReadOnly, Mode=TwoWay}" />

                        <wb:ToggleSwitch Content="IsEnabled"
                                         Margin="0,10,0,0"
                                         IsChecked="{Binding ElementName=ForceVector, Path=IsEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </controls:ControlExample.Options>
            </controls:ControlExample>

            <!-- Card 2: Nullable & Custom Axis Labels -->
            <controls:ControlExample x:Name="NullableExample"
                                     HeaderText="Nullable Components &amp; Custom Axis Labels"
                                     Description="Clear any cell to store null (e.g., unconstrained degree of freedom) and customize XLabel / YLabel / ZLabel for cylindrical or custom coordinates.">
                <StackPanel>
                    <wb:Vector3Box x:Name="CylindricalBox"
                                   MaxWidth="500"
                                   HorizontalAlignment="Left"
                                   XLabel="R"
                                   YLabel="θ"
                                   ZLabel="Z"
                                   X="25.0"
                                   Y="{x:Null}"
                                   Z="100.0"
                                   Minimum="-500"
                                   Maximum="500"
                                   Format="F1" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Gallery.HintText}"
                               Text="Notice θ is initially blank (null) while R and Z hold numeric values bounded to [-500, 500]." />
                </StackPanel>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
