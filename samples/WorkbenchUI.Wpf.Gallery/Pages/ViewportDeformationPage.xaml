<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ViewportDeformationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource Wb.FontSize.S}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="3D Deformation (Deformed Shape &amp; Animation)" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Applies ViewportMesh.Displacements × DeformationScale in the GPU vertex shader. The demo shows bending eigenmodes of a cantilever plate (Euler-Bernoulli analytical solution). Try adjusting scale, harmonic animation, undeformed wireframe overlay, and transient playback via PlaybackBar (swapping displacement arrays per frame)." />

            <!-- Mode selector + scale -->
            <WrapPanel Margin="0,12,0,4" ItemHeight="28">
                <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ModeCombo" MinWidth="130" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="ModeCombo"
                          SelectionChanged="OnModeChanged">
                    <ComboBoxItem Content="1st Bending" IsSelected="True" />
                    <ComboBoxItem Content="2nd Bending" />
                    <ComboBoxItem Content="3rd Bending" />
                </ComboBox>
                <TextBlock Text="Deformation Scale:" VerticalAlignment="Center" Margin="20,0,8,0" />
                <Slider x:Name="ScaleSlider" Width="180" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="DeformScaleSlider"
                        Minimum="0" Maximum="30" Value="5" />
                <TextBlock x:Name="ScaleText" VerticalAlignment="Center" Margin="8,0,0,0"
                           AutomationProperties.AutomationId="ScaleText"
                           Text="{Binding Value, ElementName=ScaleSlider, StringFormat=×{0:0.0}}" />
                <Button Content="Auto Scale" Click="OnAutoScaleClick" Margin="16,0,0,0"
                        AutomationProperties.AutomationId="AutoScaleButton" />
            </WrapPanel>

            <!-- Display options -->
            <WrapPanel Margin="0,0,0,8" ItemHeight="28">
                <wb:ToggleSwitch x:Name="AnimToggle" Content="Animate Vibration"
                                 AutomationProperties.AutomationId="AnimToggle" />
                <wb:ToggleSwitch x:Name="GhostToggle" Content="Undeformed Wireframe" Margin="20,0,0,0"
                                 AutomationProperties.AutomationId="UndeformedToggle" />
                <wb:ToggleSwitch x:Name="ContourToggle" Content="Contours" IsChecked="True" Margin="20,0,0,0" />
                <Button Content="Fit" Click="OnFitClick" MinWidth="60" Margin="20,0,0,0" />
            </WrapPanel>

            <!-- Viewport + Legend -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <wb:WorkbenchViewport x:Name="Viewport"
                                Grid.Column="0"
                                Height="420"
                                DeformationScale="{Binding Value, ElementName=ScaleSlider}"
                                IsDeformationAnimated="{Binding IsChecked, ElementName=AnimToggle}"
                                ShowUndeformedWireframe="{Binding IsChecked, ElementName=GhostToggle}"
                                ShowContours="{Binding IsChecked, ElementName=ContourToggle}" />

                <wb:ColorMapLegend x:Name="Legend"
                                   Grid.Column="1"
                                   Height="280"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Title="|u| [mm]" />
            </Grid>
            <TextBlock x:Name="RendererInfo" Style="{StaticResource Hint}" />

            <!-- Transient playback (frame sequence playback is application-driven) -->
            <TextBlock Text="Transient Playback (Damped Free Vibration from Initial Tip Displacement)" FontWeight="SemiBold" Margin="0,16,0,4" />
            <wb:PlaybackBar x:Name="Playback"
                            AutomationProperties.AutomationId="PlaybackBar"
                            FramesPerSecond="30"
                            CurrentFrameChanged="OnPlaybackFrameChanged" />

            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                       Text="Deformation is applied in the GPU vertex shader (pos + disp × scale). Displacements live in a separate dynamic vertex buffer (slot 1), so replacing Displacements performs a lightweight partial update suitable for per-frame transient playback. Normals remain undeformed (small-strain assumption), while picking hits the deformed geometry." />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="Built-in vibration animation oscillates as DeformationScale × sin(2πt/T) (IsDeformationAnimated). Multi-frame playback is application-driven by swapping Displacements / ScalarValues in PlaybackBar.CurrentFrameChanged (as shown here). Auto Scale applies GetSuggestedDeformationScale() so the maximum displacement is ~5% of the model diagonal." />

            <Border Height="24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
