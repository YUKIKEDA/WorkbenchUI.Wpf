<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Left">

            <!-- Hero Card -->
            <Border Background="{DynamicResource Wb.Brush.Surface.Panel}"
                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Wb.Brush.Accent.Default}"
                            CornerRadius="5,0,0,5" />

                    <StackPanel Grid.Column="1" Margin="24,22,24,22">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="WorkbenchUI.Wpf"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border Margin="12,0,0,0"
                                    Padding="8,2"
                                    CornerRadius="3"
                                    Background="{DynamicResource Wb.Brush.Accent.Muted}"
                                    BorderBrush="{DynamicResource Wb.Brush.Accent.Default}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="WPF · .NET 10"
                                           FontSize="{DynamicResource Wb.FontSize.S}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Wb.Brush.Text.Primary}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="High-density, low-saturation desktop UI library designed for CAD, CAE, and scientific engineering applications. Built with semantic Dark/Light tokens, dynamic accent color palettes, and hardware-accelerated 3D &amp; charting extensions."
                                   Foreground="{DynamicResource Wb.Brush.Text.Secondary}"
                                   TextWrapping="Wrap"
                                   MaxWidth="780"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,14" />

                        <!-- Stat Pills -->
                        <WrapPanel Margin="0,0,0,16">
                            <Border Background="{DynamicResource Wb.Brush.Surface.Window}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                    BorderThickness="1" CornerRadius="3" Padding="10,4" Margin="0,0,8,6">
                                <TextBlock Text="4 Packages" FontSize="{DynamicResource Wb.FontSize.S}" />
                            </Border>
                            <Border Background="{DynamicResource Wb.Brush.Surface.Window}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                    BorderThickness="1" CornerRadius="3" Padding="10,4" Margin="0,0,8,6">
                                <TextBlock Text="40+ Controls" FontSize="{DynamicResource Wb.FontSize.S}" />
                            </Border>
                            <Border Background="{DynamicResource Wb.Brush.Surface.Window}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                    BorderThickness="1" CornerRadius="3" Padding="10,4" Margin="0,0,8,6">
                                <TextBlock x:Name="IconStatText" Text="68 Built-in Icons" FontSize="{DynamicResource Wb.FontSize.S}" />
                            </Border>
                            <Border Background="{DynamicResource Wb.Brush.Surface.Window}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                    BorderThickness="1" CornerRadius="3" Padding="10,4" Margin="0,0,8,6">
                                <TextBlock Text="Dark &amp; Light + Dynamic Accent" FontSize="{DynamicResource Wb.FontSize.S}" />
                            </Border>
                        </WrapPanel>

                        <!-- Quick Actions -->
                        <WrapPanel>
                            <Button Content="Explore Design Tokens"
                                    Style="{DynamicResource Wb.Button.Accent}"
                                    wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Sun}"
                                    Margin="0,0,8,6"
                                    Click="ExploreTokens_Click" />
                            <Button Content="Browse Icons"
                                    wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Grid}"
                                    Margin="0,0,8,6"
                                    Click="BrowseIcons_Click" />
                            <Button Content="NavigationView (New)"
                                    wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Layout}"
                                    Margin="0,0,8,6"
                                    Click="ExploreNavigationView_Click" />
                            <Button Content="Launch Docking Shell"
                                    Style="{DynamicResource Wb.Button.Subtle}"
                                    wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Play}"
                                    Margin="0,0,0,6"
                                    Click="LaunchDockingShell_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Featured Components -->
            <TextBlock Text="Featured Components"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Start with core primitives, shells, and flagship engineering components."
                       Style="{StaticResource Gallery.HintText}"
                       Margin="0,0,0,12" />
            <WrapPanel x:Name="FeaturedPanel" Margin="0,0,0,28" />

            <!-- All Components by Category -->
            <TextBlock Text="All Components by Category"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="TotalCountHint"
                       Style="{StaticResource Gallery.HintText}"
                       Margin="0,0,0,16" />
            <StackPanel x:Name="CategoriesHost" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
