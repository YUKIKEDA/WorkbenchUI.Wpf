<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Gallery"
                Title="Settings"
                Description="Configure theme variant, dynamic accent palette, navigation pane layout, and view library metadata."
                PackageName="WorkbenchUI.Wpf"
                NamespaceName="WorkbenchUI.Wpf.Theming" />

            <!-- Theme & Appearance -->
            <Border Style="{StaticResource Gallery.CardSurface}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Theme &amp; Appearance" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="Switch between Dark and Light resource dictionaries across all windows, charts, docking panes, and controls."
                               Style="{StaticResource Gallery.HintText}" Margin="0,0,0,12" />

                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton x:Name="DarkThemeRadio"
                                     Content="Dark Theme"
                                     GroupName="AppTheme"
                                     Margin="0,0,20,6"
                                     Checked="DarkThemeRadio_Checked" />
                        <RadioButton x:Name="LightThemeRadio"
                                     Content="Light Theme"
                                     GroupName="AppTheme"
                                     Margin="0,0,24,6"
                                     Checked="LightThemeRadio_Checked" />
                        <Button Content="Match Windows Theme"
                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Refresh}"
                                Margin="0,0,12,6"
                                Click="MatchSystemTheme_Click" />
                        <TextBlock x:Name="SystemThemeLabel"
                                   Style="{StaticResource Gallery.HintText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Accent Color -->
            <Border Style="{StaticResource Gallery.CardSurface}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Accent Color" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="ThemeManager.SetAccent automatically derives Hover, Pressed, and Muted shades for the active theme."
                               Style="{StaticResource Gallery.HintText}" Margin="0,0,0,12" />

                    <WrapPanel x:Name="AccentPresetsPanel" Margin="0,0,0,12" />

                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="Custom Color:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <wb:ColorPicker x:Name="CustomAccentPicker"
                                        Width="76"
                                        IsAlphaEnabled="False"
                                        Margin="0,0,12,0"
                                        SelectedColorChanged="CustomAccentPicker_SelectedColorChanged" />
                        <Button Content="Reset to Default"
                                Style="{DynamicResource Wb.Button.Subtle}"
                                Click="ResetAccent_Click" />
                    </WrapPanel>

                    <TextBlock Text="Derived Accent Tokens" Style="{StaticResource Gallery.OptionLabel}" Margin="0,0,0,6" />
                    <UniformGrid Columns="4" MaxWidth="520" HorizontalAlignment="Left">
                        <Border Background="{DynamicResource Wb.Brush.Accent.Default}" Padding="10,8" Margin="0,0,6,0" CornerRadius="3">
                            <TextBlock Text="Default" FontSize="{DynamicResource Wb.FontSize.S}"
                                       Foreground="{DynamicResource Wb.Brush.Text.OnAccent}" HorizontalAlignment="Center" />
                        </Border>
                        <Border Background="{DynamicResource Wb.Brush.Accent.Hover}" Padding="10,8" Margin="0,0,6,0" CornerRadius="3">
                            <TextBlock Text="Hover" FontSize="{DynamicResource Wb.FontSize.S}"
                                       Foreground="{DynamicResource Wb.Brush.Text.OnAccent}" HorizontalAlignment="Center" />
                        </Border>
                        <Border Background="{DynamicResource Wb.Brush.Accent.Pressed}" Padding="10,8" Margin="0,0,6,0" CornerRadius="3">
                            <TextBlock Text="Pressed" FontSize="{DynamicResource Wb.FontSize.S}"
                                       Foreground="{DynamicResource Wb.Brush.Text.OnAccent}" HorizontalAlignment="Center" />
                        </Border>
                        <Border Background="{DynamicResource Wb.Brush.Accent.Muted}"
                                BorderBrush="{DynamicResource Wb.Brush.Accent.Default}"
                                BorderThickness="1"
                                Padding="10,8" CornerRadius="3">
                            <TextBlock Text="Muted" FontSize="{DynamicResource Wb.FontSize.S}"
                                       Foreground="{DynamicResource Wb.Brush.Text.Primary}" HorizontalAlignment="Center" />
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Navigation Pane Behavior -->
            <Border Style="{StaticResource Gallery.CardSurface}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Navigation Pane" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="Control the Gallery NavigationView display mode and expansion state."
                               Style="{StaticResource Gallery.HintText}" Margin="0,0,0,12" />

                    <Grid MaxWidth="420" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="PaneDisplayMode" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <ComboBox x:Name="PaneModeCombo"
                                  Grid.Column="1"
                                  Width="180"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,10"
                                  SelectionChanged="PaneModeCombo_SelectionChanged" />

                        <TextBlock Grid.Row="1" Text="IsPaneOpen" VerticalAlignment="Center" />
                        <wb:ToggleSwitch x:Name="PaneOpenSwitch"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Content="Expanded"
                                         Checked="PaneOpenSwitch_Changed"
                                         Unchecked="PaneOpenSwitch_Changed" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About & Keyboard Shortcuts -->
            <Border Style="{StaticResource Gallery.CardSurface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Packages &amp; Runtime" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="• WorkbenchUI.Wpf (Core controls &amp; theming)" Margin="0,2" />
                        <TextBlock Text="• WorkbenchUI.Wpf.Docking (AvalonDock integration)" Margin="0,2" />
                        <TextBlock Text="• WorkbenchUI.Wpf.Charts (ScottPlot charts)" Margin="0,2" />
                        <TextBlock Text="• WorkbenchUI.Wpf.Viewport3D (Hardware-accelerated 3D)" Margin="0,2" />
                        <TextBlock Text="Target: .NET 10 Windows (WPF) · MIT License"
                                   Style="{StaticResource Gallery.HintText}"
                                   Margin="0,10,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Keyboard Shortcuts" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource Wb.Brush.Surface.Window}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}" BorderThickness="1"
                                    CornerRadius="3" Padding="6,2" Margin="0,0,0,6" HorizontalAlignment="Left">
                                <TextBlock Text="Ctrl + K" FontFamily="{DynamicResource Wb.FontFamily.Monospace}"
                                           FontSize="{DynamicResource Wb.FontSize.S}" />
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Focus global control search" VerticalAlignment="Center" Margin="0,0,0,6" />

                            <Border Grid.Row="1" Background="{DynamicResource Wb.Brush.Surface.Window}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}" BorderThickness="1"
                                    CornerRadius="3" Padding="6,2" Margin="0,0,0,6" HorizontalAlignment="Left">
                                <TextBlock Text="Up / Down" FontFamily="{DynamicResource Wb.FontFamily.Monospace}"
                                           FontSize="{DynamicResource Wb.FontSize.S}" />
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Navigate search results" VerticalAlignment="Center" Margin="0,0,0,6" />

                            <Border Grid.Row="2" Background="{DynamicResource Wb.Brush.Surface.Window}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}" BorderThickness="1"
                                    CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="Esc" FontFamily="{DynamicResource Wb.FontFamily.Monospace}"
                                           FontSize="{DynamicResource Wb.FontSize.S}" />
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Dismiss popups and compact flyouts" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
