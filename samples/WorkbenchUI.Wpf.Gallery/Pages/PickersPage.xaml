<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.PickersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Wb.FontSize.L}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource Wb.FontSize.S}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <ContextMenu x:Key="ViewPresetMenu">
            <MenuItem Header="Front" Click="ViewPreset_Click" />
            <MenuItem Header="Top" Click="ViewPreset_Click" />
            <MenuItem Header="Right" Click="ViewPreset_Click" />
            <Separator />
            <MenuItem Header="Isometric" Click="ViewPreset_Click" />
        </ContextMenu>

        <ContextMenu x:Key="SolveOptionsMenu">
            <MenuItem Header="Run (Current Settings)" Click="SolveOption_Click" />
            <MenuItem Header="Remesh and Run" Click="SolveOption_Click" />
            <MenuItem Header="Submit to Batch Queue..." Click="SolveOption_Click" />
        </ContextMenu>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Pickers &amp; Range" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />

            <TextBlock Text="DropDownButton / SplitButton" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <wb:DropDownButton Content="View"
                                   DropDownMenu="{StaticResource ViewPresetMenu}"
                                   Margin="0,0,8,0" />
                <wb:SplitButton x:Name="SolveButton"
                                Content="Run Analysis"
                                Click="Solve_Click"
                                DropDownMenu="{StaticResource SolveOptionsMenu}" />
            </StackPanel>
            <TextBlock x:Name="DropDownResult" Style="{StaticResource Hint}"
                       Text="DropDownButton opens the menu on click; SplitButton invokes Command on the left and opens the menu via ▼ on the right (also F4 / Alt+↓)." />

            <TextBlock Text="PathBox (File / Folder Picker)" Style="{StaticResource SectionHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Mesh File" VerticalAlignment="Center" />
                <wb:PathBox x:Name="OpenPathBox" Grid.Column="1" Margin="0,2"
                            Mode="OpenFile"
                            DialogTitle="Open Mesh File"
                            Filter="Mesh files (*.msh;*.inp)|*.msh;*.inp|All files (*.*)|*.*" />
                <TextBlock Grid.Row="1" Text="Output Path" VerticalAlignment="Center" />
                <wb:PathBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                            Mode="SaveFile"
                            Filter="Result files (*.vtk)|*.vtk" />
                <TextBlock Grid.Row="2" Text="Working Folder" VerticalAlignment="Center" />
                <wb:PathBox Grid.Row="2" Grid.Column="1" Margin="0,2" Mode="Folder" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="The … button opens the standard Open/Save/Folder dialog; direct typing is also supported. Handle BrowseRequested to plug in a custom dialog." />

            <TextBlock Text="Vector3Box (XYZ Vector Input)" Style="{StaticResource SectionHeader}" />
            <wb:Vector3Box x:Name="ForceVector" MaxWidth="480" HorizontalAlignment="Left"
                           X="0" Y="0" Z="-9.8" Unit="m/s²" Format="G4" />
            <TextBlock Margin="0,4,0,0">
                <Run Text="Value = (" /><Run Text="{Binding ElementName=ForceVector, Path=X}" /><Run Text=", " /><Run Text="{Binding ElementName=ForceVector, Path=Y}" /><Run Text=", " /><Run Text="{Binding ElementName=ForceVector, Path=Z}" /><Run Text=")" />
            </TextBlock>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Example of a gravity vector. Follows the same nullable convention as NumericBox (blank = null), with shared unit and range across all three axes." />

            <TextBlock Text="RangeSlider (Contour Range Selection)" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <wb:ColorMapLegend x:Name="RangeLegend" Height="180" Title="Stress [MPa]" />
                <StackPanel Width="280" Margin="24,0,0,0" VerticalAlignment="Center">
                    <wb:RangeSlider x:Name="ContourRange"
                                    Minimum="0" Maximum="500"
                                    LowerValue="100" UpperValue="350" />
                    <TextBlock Margin="0,8,0,0">
                        <Run Text="{Binding ElementName=ContourRange, Path=LowerValue, StringFormat='Min = {0:F0}'}" />
                        <Run Text=" / " />
                        <Run Text="{Binding ElementName=ContourRange, Path=UpperValue, StringFormat='Max = {0:F0}'}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Drag either thumb to adjust bounds individually, or drag the center bar to pan the range while preserving width. Bound two-way to ColorScale Min/Max." />
                    <wb:RangeSlider Margin="0,16,0,0" Minimum="0" Maximum="100"
                                    LowerValue="20" UpperValue="60" IsEnabled="False" />
                    <TextBlock Style="{StaticResource Hint}" Text="Disabled state" />
                </StackPanel>
                <wb:RangeSlider Orientation="Vertical" Height="180" Margin="32,0,0,0"
                                Minimum="0" Maximum="1" LowerValue="0.25" UpperValue="0.75" />
            </StackPanel>

            <TextBlock Text="ColorPicker / ColorEditor" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="260">
                    <TextBlock Text="Dropdown (Alpha Enabled)" Margin="0,0,0,4" />
                    <wb:ColorPicker x:Name="PartColorPicker" Width="72" HorizontalAlignment="Left"
                                    SelectedColor="#CC0078D7" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding ElementName=PartColorPicker, Path=SelectedColor, StringFormat='SelectedColor = {0}'}" />
                    <TextBlock Text="Alpha Disabled (Always Opaque)" Margin="0,16,0,4" />
                    <wb:ColorPicker Width="72" HorizontalAlignment="Left"
                                    SelectedColor="#E81123" IsAlphaEnabled="False" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                               Text="Click a swatch to open ColorEditor in a popup. Palette swatches apply RGB only while preserving the current alpha." />
                </StackPanel>
                <StackPanel Margin="32,0,0,0">
                    <TextBlock Text="Inline Embedded (ColorEditor)" Margin="0,0,0,4" />
                    <Border Background="{DynamicResource Wb.Brush.Surface.Panel}"
                            BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="10"
                            HorizontalAlignment="Left">
                        <wb:ColorEditor Width="300" SelectedColor="#FF16C60C" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <Border Height="24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
