<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.LogConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="LogConsole &amp; ProgressDisplay"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource Wb.Brush.Surface.Panel}"
                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Wb.CornerRadius}"
                    Padding="12,8"
                    Margin="0,0,0,8">
                <wb:ProgressDisplay x:Name="Progress"
                                    Text="Idle"
                                    CancelText="Cancel" />
            </Border>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="StartButton" Content="Run Analysis" Click="OnStart" />
                <Button Content="10,000-Line Burst" Click="OnBurst" Margin="8,0,0,0" />
                <Button Content="Clear" Click="OnClear" Margin="8,0,0,0" />
                <CheckBox x:Name="TimestampCheck" Content="Timestamps" IsChecked="True"
                          Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <wb:LogConsole x:Name="Console"
                           ShowTimestamps="{Binding ElementName=TimestampCheck, Path=IsChecked}" />
        </DockPanel>

        <StackPanel Grid.Column="1" Margin="24,44,0,0">
            <TextBlock Text="Demo Notes" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Wb.Brush.Text.Secondary}">
                <Run Text="• Click &quot;Run Analysis&quot; to simulate a solver run" /><LineBreak />
                <Run Text="  (progress + elapsed time + cancel integration)." /><LineBreak />
                <Run Text="• Logs are appended from a background thread" /><LineBreak />
                <Run Text="  and flushed to the UI in batches every 100 ms." /><LineBreak />
                <Run Text="• Auto-scrolls only when at the bottom" /><LineBreak />
                <Run Text="  (scroll up to pause auto-follow)." /><LineBreak />
                <Run Text="• Select lines and press Ctrl+C to copy." /><LineBreak />
                <Run Text="• 5,000-line ring buffer capacity" /><LineBreak />
                <Run Text="  (use the burst button to verify eviction)." />
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
