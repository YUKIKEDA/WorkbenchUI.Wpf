<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.LogConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Data &amp; Visualization"
                Title="LogConsole"
                Description="Thread-safe 5,000-line ring-buffered diagnostic console with 100 ms UI batching, severity filtering, auto-scroll pause on scroll-up, and Ctrl+C copy."
                PackageName="WorkbenchUI.Wpf"
                NamespaceName="WorkbenchUI.Wpf.Controls" />

            <controls:ControlExample x:Name="ConsoleExample"
                                     HeaderText="Streaming Solver LogConsole"
                                     Description="Appends logs safely from worker threads and pairs with ProgressDisplay for live solver cancellation."
                                     OptionsWidth="250">
                <StackPanel>
                    <Border Background="{DynamicResource Wb.Brush.Surface.Panel}"
                            BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12,8"
                            Margin="0,0,0,10">
                        <wb:ProgressDisplay x:Name="Progress"
                                            Text="Idle"
                                            CancelText="Cancel" />
                    </Border>

                    <wb:LogConsole x:Name="Console"
                                   Height="340"
                                   ShowTimestamps="{Binding ElementName=TimestampCheck, Path=IsChecked}" />
                </StackPanel>

                <controls:ControlExample.Options>
                    <StackPanel>
                        <Button x:Name="StartButton"
                                Content="Run Analysis"
                                Style="{DynamicResource Wb.Button.Accent}"
                                wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Play}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"
                                Click="OnStart" />

                        <Button Content="10,000-Line Burst"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"
                                Click="OnBurst" />

                        <Button Content="Clear Buffer"
                                Style="{DynamicResource Wb.Button.Subtle}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12"
                                Click="OnClear" />

                        <wb:ToggleSwitch x:Name="TimestampCheck"
                                         Content="ShowTimestamps"
                                         IsChecked="True" />

                        <TextBlock Text="Notes" Style="{StaticResource Gallery.OptionLabel}" />
                        <TextBlock Text="• Worker threads append via LogBuffer.Append" Style="{StaticResource Gallery.HintText}" Margin="0,2" />
                        <TextBlock Text="• Auto-follows bottom until user scrolls up" Style="{StaticResource Gallery.HintText}" Margin="0,2" />
                        <TextBlock Text="• Select lines and press Ctrl+C to copy" Style="{StaticResource Gallery.HintText}" Margin="0,2" />
                    </StackPanel>
                </controls:ControlExample.Options>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
