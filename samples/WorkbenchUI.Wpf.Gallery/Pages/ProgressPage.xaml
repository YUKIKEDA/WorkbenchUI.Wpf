<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="Feedback &amp; Windows"
                Title="Progress &amp; BusyOverlay"
                Description="Complete progress and wait indicator family: ProgressBar, vector ProgressRing, cancellable ProgressDisplay with elapsed clock, and BusyOverlay."
                PackageName="WorkbenchUI.Wpf"
                NamespaceName="WorkbenchUI.Wpf.Controls" />

            <!-- Card 1: ProgressBar & ProgressRing -->
            <controls:ControlExample x:Name="BasicProgressExample"
                                     HeaderText="ProgressBar &amp; ProgressRing"
                                     Description="Use ProgressBar for determinate percentages and ProgressRing (sized via Width/Height, colored via Foreground) for indeterminate activity.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" MaxWidth="360" HorizontalAlignment="Left">
                        <TextBlock Text="Determinate ProgressBar" Style="{StaticResource Gallery.OptionLabel}" Margin="0,0,0,6" />
                        <ProgressBar Value="{Binding ElementName=PercentSlider, Path=Value}" Margin="0,0,0,14" />

                        <TextBlock Text="Indeterminate ProgressBar" Style="{StaticResource Gallery.OptionLabel}" Margin="0,0,0,6" />
                        <ProgressBar x:Name="IndeterminateBar" IsIndeterminate="True" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="ProgressRing Sizes" Style="{StaticResource Gallery.OptionLabel}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <wb:ProgressRing Width="16" Height="16" Margin="0,0,16,0"
                                             IsActive="{Binding ElementName=RingSwitch, Path=IsChecked}" />
                            <wb:ProgressRing Margin="0,0,16,0"
                                             IsActive="{Binding ElementName=RingSwitch, Path=IsChecked}" />
                            <wb:ProgressRing Width="44" Height="44"
                                             Foreground="{DynamicResource Wb.Brush.Warning}"
                                             IsActive="{Binding ElementName=RingSwitch, Path=IsChecked}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <controls:ControlExample.Options>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Gallery.OptionLabel}"
                                   Margin="0,0,0,4"
                                   Text="{Binding ElementName=PercentSlider, Path=Value, StringFormat='Value: {0:F0}%'}" />
                        <Slider x:Name="PercentSlider" Minimum="0" Maximum="100" Value="62" />

                        <wb:ToggleSwitch Content="Bar IsIndeterminate"
                                         Margin="0,12,0,0"
                                         IsChecked="{Binding ElementName=IndeterminateBar, Path=IsIndeterminate, Mode=TwoWay}" />

                        <wb:ToggleSwitch x:Name="RingSwitch"
                                         Content="Ring IsActive"
                                         IsChecked="True"
                                         Margin="0,10,0,0" />
                    </StackPanel>
                </controls:ControlExample.Options>
            </controls:ControlExample>

            <!-- Card 2: ProgressDisplay -->
            <controls:ControlExample x:Name="DisplayExample"
                                     HeaderText="ProgressDisplay (Progress + Elapsed + CancelCommand)"
                                     Description="Tracks a simulated background job with automatic elapsed timer and integrated CancelCommand.">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                    <Border Background="{DynamicResource Wb.Brush.Surface.Panel}"
                            BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12,10"
                            Margin="0,0,0,10">
                        <wb:ProgressDisplay x:Name="JobProgress"
                                            Text="Idle"
                                            CancelText="Cancel" />
                    </Border>
                    <Button x:Name="StartJobButton"
                            Content="Simulate Background Job"
                            Style="{DynamicResource Wb.Button.Accent}"
                            wb:ButtonAssist.Icon="{x:Static wb:WorkbenchIcons.Play}"
                            HorizontalAlignment="Left"
                            Click="StartJobButton_Click" />
                </StackPanel>
            </controls:ControlExample>

            <!-- Card 3: BusyOverlay -->
            <controls:ControlExample x:Name="BusyExample"
                                     HeaderText="BusyOverlay"
                                     Description="Blocks interaction over a region while displaying either the built-in spinner + BusyText or custom BusyContent (such as ProgressDisplay).">
                <StackPanel>
                    <Button Content="Trigger Busy State (3s)"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10"
                            Click="StartBusy_Click" />

                    <Grid Height="170">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <wb:BusyOverlay x:Name="DefaultBusyOverlay" BusyText="Generating mesh...">
                            <Border Background="{DynamicResource Wb.Brush.Surface.Panel}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Default Spinner Overlay" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBox Text="Input disabled while busy" Margin="0,0,0,8" />
                                    <Button Content="Dummy Action" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </wb:BusyOverlay>

                        <wb:BusyOverlay x:Name="ProgressBusyOverlay" Grid.Column="2">
                            <wb:BusyOverlay.BusyContent>
                                <wb:ProgressDisplay x:Name="BusyProgress"
                                                    Width="250"
                                                    Text="Running analysis..."
                                                    IsIndeterminate="True" />
                            </wb:BusyOverlay.BusyContent>
                            <Border Background="{DynamicResource Wb.Brush.Surface.Panel}"
                                    BorderBrush="{DynamicResource Wb.Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Custom BusyContent = ProgressDisplay" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBox Text="Input disabled while busy" Margin="0,0,0,8" />
                                    <Button Content="Dummy Action" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </wb:BusyOverlay>
                    </Grid>
                </StackPanel>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
