<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ViewportBenchmarkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wb.Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource Wb.FontSize.S}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="3D Benchmark (Large-Mesh Performance)" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Measures build and render performance on parametrically generated synthetic wave meshes. Vertex/index buffers are chunked with frustum culling, and meshes above 5M triangles automatically enable interactive LOD (grid clustering at ~1/20) during camera motion. Also demonstrates GPU ID picking, contours, and the GetStatistics() API. 100M triangles requires ~16 GB+ RAM / 6 GB+ VRAM; 200M requires ~32 GB+ RAM / 12 GB+ VRAM." />

            <WrapPanel Margin="0,12,0,4" ItemHeight="30">
                <TextBlock Text="Triangles:" VerticalAlignment="Center" />
                <ComboBox x:Name="SizeCombo" Width="110" Margin="8,0,0,0" SelectedIndex="1"
                          AutomationProperties.AutomationId="SizeCombo"
                          SelectionChanged="OnSizeChanged">
                    <ComboBoxItem Content="100K" Tag="100000" />
                    <ComboBoxItem Content="1M" Tag="1000000" />
                    <ComboBoxItem Content="5M" Tag="5000000" />
                    <ComboBoxItem Content="10M" Tag="10000000" />
                    <ComboBoxItem Content="25M" Tag="25000000" />
                    <ComboBoxItem Content="50M" Tag="50000000" />
                    <ComboBoxItem Content="100M" Tag="100000000" />
                    <ComboBoxItem Content="200M" Tag="200000000" />
                </ComboBox>
                <wb:ToggleSwitch x:Name="RotateToggle" Content="Orbit Animation (FPS)" Margin="20,0,0,0"
                                 AutomationProperties.AutomationId="RotateToggle"
                                 Checked="OnRotateToggleChanged" Unchecked="OnRotateToggleChanged" />
                <wb:ToggleSwitch x:Name="LodToggle" Content="Interactive LOD" IsChecked="True" Margin="20,0,0,0"
                                 AutomationProperties.AutomationId="LodToggle"
                                 Checked="OnLodToggleChanged" Unchecked="OnLodToggleChanged" />
                <Button Content="Fit" Click="OnFitClick" MinWidth="60" Margin="20,0,0,0" />
                <Button Content="Top" Click="OnTopViewClick" MinWidth="60" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="TopViewButton" />
            </WrapPanel>

            <wb:WorkbenchViewport x:Name="Viewport"
                            Height="440"
                            PickMode="Face"
                            DeformationScale="0" />

            <!-- Async build progress (keeps displaying and interacting with the previous scene during build) -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="BuildProgress" Grid.Column="0" Height="10"
                             VerticalAlignment="Center"
                             Minimum="0" Maximum="1"
                             AutomationProperties.AutomationId="BuildProgress" />
                <TextBlock x:Name="BuildText" Grid.Column="1" Style="{StaticResource Hint}"
                           Margin="10,0,0,0" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="BuildText"
                           Text="Build: -" />
            </Grid>

            <TextBlock x:Name="StatsText" Style="{StaticResource Hint}" Margin="0,6,0,0"
                       AutomationProperties.AutomationId="StatsText"
                       Text="(Waiting for build)" />
            <TextBlock x:Name="FpsText" Style="{StaticResource Hint}"
                       AutomationProperties.AutomationId="FpsText"
                       Text="FPS: -" />
            <TextBlock x:Name="PickText" Style="{StaticResource Hint}"
                       AutomationProperties.AutomationId="PickText"
                       Text="Pick: Click to select a face (verifies chunk base-vertex offsets preserve global triangle IDs)" />
            <TextBlock x:Name="RendererInfo" Style="{StaticResource Hint}" />

            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                       Text="Build time includes normal calculation (octahedral 16-bit compression), chunking, LOD generation (grid clustering), and GPU upload. Edge extraction is skipped above EdgeExtractionLimit (default 5M triangles), and interactive LOD is built above InteractiveLodThreshold (default 5M triangles; the Interactive LOD toggle switches this threshold). Render time measures a single frame from command submission through GPU completion. Orbit animation renders with LOD, while idle frames render at full resolution (check 'LOD active' in stats). Drawn chunks reflects frustum culling and decreases as you zoom in." />

            <Border Height="24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
