<UserControl x:Class="WorkbenchUI.Wpf.Gallery.Pages.ViewportBenchmarkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wb="https://schemas.workbenchui.dev/wpf"
             xmlns:controls="clr-namespace:WorkbenchUI.Wpf.Gallery.Controls"
             mc:Ignorable="d">
    <ScrollViewer Style="{StaticResource Gallery.PageScrollViewer}">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Left">

            <controls:GalleryPageHeader
                Category="3D Viewport"
                Title="Large-Mesh Benchmark"
                Description="Chunked vertex/index buffers, frustum culling, automatic interactive LOD above 5M triangles, GPU ID picking, and GetStatistics() telemetry up to 200M triangles."
                PackageName="WorkbenchUI.Wpf.Viewport3D"
                NamespaceName="WorkbenchUI.Wpf.Viewport3D" />

            <Border Style="{StaticResource Gallery.CardSurface}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,10" ItemHeight="30">
                        <TextBlock Text="Triangles:" VerticalAlignment="Center" />
                        <ComboBox x:Name="SizeCombo" Width="110" Margin="8,0,0,0" SelectedIndex="1"
                                  AutomationProperties.AutomationId="SizeCombo"
                                  SelectionChanged="OnSizeChanged">
                            <ComboBoxItem Content="100K" Tag="100000" />
                            <ComboBoxItem Content="1M" Tag="1000000" />
                            <ComboBoxItem Content="5M" Tag="5000000" />
                            <ComboBoxItem Content="10M" Tag="10000000" />
                            <ComboBoxItem Content="25M" Tag="25000000" />
                            <ComboBoxItem Content="50M" Tag="50000000" />
                            <ComboBoxItem Content="100M" Tag="100000000" />
                            <ComboBoxItem Content="200M" Tag="200000000" />
                        </ComboBox>
                        <wb:ToggleSwitch x:Name="RotateToggle" Content="Orbit Animation (FPS)" Margin="20,0,0,0"
                                         AutomationProperties.AutomationId="RotateToggle"
                                         Checked="OnRotateToggleChanged" Unchecked="OnRotateToggleChanged" />
                        <wb:ToggleSwitch x:Name="LodToggle" Content="Interactive LOD" IsChecked="True" Margin="20,0,0,0"
                                         AutomationProperties.AutomationId="LodToggle"
                                         Checked="OnLodToggleChanged" Unchecked="OnLodToggleChanged" />
                        <Button Content="Fit" Click="OnFitClick" MinWidth="60" Margin="20,0,0,0" />
                        <Button Content="Top" Click="OnTopViewClick" MinWidth="60" Margin="8,0,0,0"
                                AutomationProperties.AutomationId="TopViewButton" />
                    </WrapPanel>

                    <Border BorderBrush="{DynamicResource Wb.Brush.Border.Default}" BorderThickness="1">
                        <wb:WorkbenchViewport x:Name="Viewport"
                                              Height="440"
                                              PickMode="Face"
                                              DeformationScale="0" />
                    </Border>

                    <!-- Async build progress -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="BuildProgress" Grid.Column="0" Height="10"
                                     VerticalAlignment="Center"
                                     Minimum="0" Maximum="1"
                                     AutomationProperties.AutomationId="BuildProgress" />
                        <TextBlock x:Name="BuildText" Grid.Column="1" Style="{StaticResource Gallery.HintText}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="BuildText"
                                   Text="Build: -" />
                    </Grid>

                    <TextBlock x:Name="StatsText" Style="{StaticResource Gallery.HintText}" Margin="0,8,0,0"
                               AutomationProperties.AutomationId="StatsText"
                               Text="(Waiting for build)" />
                    <TextBlock x:Name="FpsText" Style="{StaticResource Gallery.HintText}" Margin="0,3,0,0"
                               AutomationProperties.AutomationId="FpsText"
                               Text="FPS: -" />
                    <TextBlock x:Name="PickText" Style="{StaticResource Gallery.HintText}" Margin="0,3,0,0"
                               AutomationProperties.AutomationId="PickText"
                               Text="Pick: Click to select a face (verifies chunk base-vertex offsets preserve global triangle IDs)" />
                    <TextBlock x:Name="RendererInfo" Style="{StaticResource Gallery.HintText}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Gallery.CardSurface}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Benchmark Notes" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Gallery.HintText}"
                               Text="Build time includes normal compression (octahedral 16-bit), chunking, LOD generation, and GPU upload. 100M triangles requires ~16 GB+ RAM / 6 GB+ VRAM; 200M requires ~32 GB+ RAM / 12 GB+ VRAM." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
